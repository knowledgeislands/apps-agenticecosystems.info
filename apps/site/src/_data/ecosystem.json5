    { id: 'qwen', name: 'Qwen', group: 'chinese-providers', roles: [], placeholder: true },
    { id: 'deepseek', name: 'DeepSeek', group: 'chinese-providers', roles: [], placeholder: true },
    { id: 'glm', name: 'GLM', group: 'chinese-providers', roles: [], placeholder: true },
    { id: 'kimi', name: 'Kimi', group: 'chinese-providers', roles: [], placeholder: true },
    { id: 'minimax', name: 'MiniMax', group: 'chinese-providers', roles: [], placeholder: true },
    { id: 'z-ai', name: 'Z.ai', group: 'chinese-providers', roles: [], note: 'A separate entry from Zed Industries.', placeholder: true },

    { id: 'local-models', name: 'Local models', group: 'local-models', roles: ['model'], note: 'Models run on your own machine, and the approaches to running them.', placeholder: true },

    { id: 'orca', name: 'Orca', group: 'hosts-and-bots', roles: ['host'], note: 'An agent host: it manages agentic sessions.', placeholder: true },
    { id: 'openclaw', name: 'OpenClaw', group: 'hosts-and-bots', roles: [], placeholder: true },
    { id: 'paperclip', name: 'Paperclip', group: 'hosts-and-bots', roles: [], note: 'An orchestrator. Its own word "hires" is one the crosswalk compares.', placeholder: true },
    { id: 'gas-city', name: 'Gas City', group: 'hosts-and-bots', roles: [], note: 'An orchestrator.', placeholder: true },

    { id: 'claude-code', name: 'Claude Code', maker: 'Anthropic', group: 'applications-and-harnesses', roles: ['harness'], note: 'An agentic harness.', placeholder: true },
    { id: 'zed', name: 'Zed', maker: 'Zed Industries', group: 'applications-and-harnesses', roles: [], note: 'An editor. A separate entry from Z.ai.', placeholder: true },
    { id: 'delta', name: 'Delta', maker: 'Zed Industries', group: 'applications-and-harnesses', roles: [], note: 'A collaborative thread with its own worktree, in public beta in November 2026.', placeholder: true },
