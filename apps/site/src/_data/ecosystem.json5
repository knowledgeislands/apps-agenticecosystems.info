// The ecosystem map the page renders: its terms, its layers and its products.
//
// This file is not the canonical source. The knowledge is planned to live in Knowledge Islands Principal, as the
// Agentic Ecosystems knowledge graph in `Resources/Agentic Ecosystems/`, layered under the KI Agent Backpack's
// `ki-agentic-systems` terms. A later sync replaces this file from there, at a pinned revision, and every entry then
// cites its card.
//
// Until then it is a seed. It holds only what the plan for the map already states, and every entry is marked
// `placeholder: true`, which the page shows. `scripts/verify-ecosystem.ts` validates the shape during the build.
{
  meta: {
    status: 'placeholder',
    revised: '2026-11-21',
    seededFrom: 'the Knowledge Islands plan for the agentic systems ecosystem map, 21 November 2026',
    canonicalHome: 'Knowledge Islands Principal, Resources/Agentic Ecosystems/ (planned)',
  },

  terms: [
    {
      id: 'agent-host',
      label: 'Agent host',
      definition: 'The surface that manages agentic sessions, such as Orca. It is distinct from the machine and from the execution environment.',
      placeholder: true,
    },
    {
      id: 'agentic-harness',
      label: 'Agentic harness',
      alsoCalled: ['agent harness'],
      definition: 'What an agentic session runs through, such as Claude Code. Anthropic writes "agentic harness"; Google and Microsoft write "agent harness".',
      placeholder: true,
    },
    {
      id: 'agentic-session',
      label: 'Agentic session',
      definition: 'A session that uses an agentic harness and a large language model.',
      placeholder: true,
    },
    {
      id: 'execution-environment',
      label: 'Execution environment',
      definition: "The bounded place where a session's tool calls actually run: the files, processes, network and credentials they can reach. It has a location and an isolation. It may be provided by the agent host, the harness or the vendor, but it is none of them. A worktree is a working folder, not an environment.",
      placeholder: true,
    },
    {
      id: 'actor',
      label: 'Actor',
      definition: 'The umbrella for whoever does the work, whether through sessions or as a bot. Session and bot are the two actor types.',
      placeholder: true,
    },
    {
      id: 'bot',
      label: 'Bot',
      definition: 'A durable, multi-session identity with its own memory and processes.',
      placeholder: true,
    },
    {
      id: 'product-role',
      label: 'Product role',
      definition: 'A part a product plays in the ecosystem: model, harness, application, host or bot. One product may play several.',
      placeholder: true,
    },
  ],

  layers: {
    note: 'The rungs are the terms the plan names, from the machine up to the model. Their order and wording wait on the terminology crosswalk.',
    rungs: [
      { id: 'machine', label: 'Machine', summary: 'The computer the work runs on. A virtual machine counts as a machine.', placeholder: true },
      { id: 'execution-environment', label: 'Execution environment', summary: "Where a session's tool calls run, with its location and its isolation.", placeholder: true },
      { id: 'agent-host', label: 'Agent host', summary: 'The surface that manages sessions.', placeholder: true },
      { id: 'agentic-harness', label: 'Agentic harness', summary: 'What a session runs through.', placeholder: true },
      { id: 'agentic-session', label: 'Agentic session', summary: 'Uses an agentic harness and a model.', placeholder: true },
      { id: 'model', label: 'Model', summary: 'The large language model a session uses.', placeholder: true },
    ],
  },

  productRoles: [
    { id: 'model', label: 'Model' },
    { id: 'harness', label: 'Harness' },
    { id: 'application', label: 'Application' },
    { id: 'host', label: 'Host' },
    { id: 'bot', label: 'Bot' },
  ],

  productGroups: [
    { id: 'vendors', label: 'Major vendors' },
    { id: 'chinese-providers', label: 'Chinese providers and models' },
    { id: 'local-models', label: 'Local models' },
    { id: 'hosts-and-bots', label: 'Hosts and bot platforms' },
    { id: 'applications-and-harnesses', label: 'Applications and harnesses' },
  ],

  products: [
    { id: 'google', name: 'Google', group: 'vendors', roles: [], placeholder: true },
