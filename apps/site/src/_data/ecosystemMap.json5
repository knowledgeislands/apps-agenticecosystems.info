      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "Several makers' models: GPT-5.5 Chat the standard harness's default, Claude Opus 4.8 and Claude Sonnet 5 generally available, and Mistral Medium 3.5 experimental &quot;alongside Anthropic, xAI, and other supported providers&quot;",
          "sources": [
            {
              "id": "S5",
              "titleHtml": "Microsoft Learn, What's new in Copilot Studio",
              "read": "2026-11-22",
              "url": "https://learn.microsoft.com/en-us/microsoft-copilot-studio/whats-new"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "unknown",
          "detailHtml": "Memory gives &quot;persistent context across interactions&quot; and session transcripts are kept for analytics; resuming a session not described",
