          "slug": "channel",
          "value": "yes",
          "detailHtml": "Telegram, WeChat, QQ, DingTalk, WeCom, Feishu, Email, GitHub, GitLab and webhooks into a kept session, by default &quot;One session per user&quot;; a message while the agent works &quot;cancels the current request and starts working on your new message&quot;; GitHub events reach the &quot;PR-bound session&quot;; the daemon-managed mode is experimental",
          "sources": [
            {
              "id": "S13",
              "titleHtml": "Qwen, Channels overview",
              "read": "2026-11-22",
              "url": "https://qwenlm.github.io/qwen-code-docs/en/users/features/channels/overview/"
