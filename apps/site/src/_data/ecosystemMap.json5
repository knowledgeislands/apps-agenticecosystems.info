    {
      "id": "product.hermes-agent",
      "slug": "hermes-agent",
      "name": "Hermes Agent",
      "title": "Hermes Agent (Nous Research)",
      "vendor": "Nous Research",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.hermes-agent.md",
      "summaryHtml": "Hermes Agent lets one person keep a personal agent that remembers them and works unattended, reached from a terminal, a desktop app or a chat app: &quot;the self-improving AI agent&quot;, with &quot;a built-in learning loop&quot; that &quot;creates skills from experience&quot; and &quot;searches its own past conversations&quot;, that can run &quot;on a $5 VPS, a GPU cluster, or serverless infrastructure&quot; (<a href=\"https://github.com/NousResearch/hermes-agent\">S2</a>). Nous Research makes it, in the <code>NousResearch</code> GitHub organisation (<a href=\"https://hermes-agent.nousresearch.com/\">S1</a>, <a href=\"https://github.com/NousResearch/hermes-agent\">S2</a>). It runs as a terminal interface and CLI, a desktop app for macOS, Windows and Linux, a browser Webapp, a messaging gateway onto Telegram, Discord, Slack, WhatsApp, Signal, email and other platforms, and on Android through Termux (<a href=\"https://github.com/NousResearch/hermes-agent\">S2</a>, <a href=\"https://github.com/NousResearch/hermes-agent/releases/tag/v0.23.0\">S4</a>, <a href=\"https://hermes-agent.nousresearch.com/docs/user-guide/desktop\">S14</a>, <a href=\"https://hermes-agent.nousresearch.com/docs/user-guide/messaging\">S15</a>). It &quot;is free and open source under the MIT license&quot;, with models and hosted services, such as the Nous Portal subscription, priced separately (<a href=\"https://hermes-agent.nousresearch.com/\">S1</a>, <a href=\"https://github.com/NousResearch/hermes-agent\">S2</a>). The latest release seen is v0.23.3, of 19 November 2026 (<a href=\"https://github.com/NousResearch/hermes-agent/releases/tag/v0.23.3\">S3</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a <a href=\"/glossary/client/\">client</a>; Orca runs it as a bot agent (<a href=\"https://github.com/stablyai/orca/releases/tag/v1.4.268\">S23</a>).",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
