    {
      "id": "product.openclaw",
      "slug": "openclaw",
      "name": "OpenClaw",
      "title": "OpenClaw (OpenClaw Foundation)",
      "vendor": "OpenClaw Foundation",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.openclaw.md",
      "summaryHtml": "OpenClaw is a personal AI agent its user controls from the chat apps they already use, &quot;the AI that really does things&quot; (<a href=\"https://openclaw.ai\">S1</a>). The OpenClaw Foundation makes it, a US 501(c)(3) that &quot;employs the core team and signs releases&quot;; Peter Steinberger created it, and it was called Clawd and then Moltbot before OpenClaw (<a href=\"https://openclaw.ai\">S1</a>, <a href=\"https://github.com/openclaw/openclaw\">S2</a>, <a href=\"https://openclaw.ai/blog/introducing-openclaw\">S4</a>). A local Gateway is &quot;the local control plane for sessions, tools, events, and channel connections&quot;, with a CLI, a terminal interface, a browser Control UI and apps for desktop and mobile (<a href=\"https://github.com/openclaw/openclaw\">S2</a>). It runs its own agent and other makers' harnesses, so it is an <a href=\"/glossary/agent-harness/\">agent harness</a> and an <a href=\"/glossary/agent-host/\">agent host</a> (<a href=\"https://docs.openclaw.ai/concepts/agent-runtimes\">S13</a>, <a href=\"https://docs.openclaw.ai/cli/acp\">S14</a>). It is MIT open source: &quot;No subscription. No hosted tier. No token.&quot; (<a href=\"https://openclaw.ai\">S1</a>). The latest release seen is 2026.11.6, of 19 November 2026 (<a href=\"https://github.com/openclaw/openclaw/releases\">S3</a>). It is a <a href=\"/glossary/client/\">client</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-host",
          "label": "Agent host",
          "url": "/glossary/agent-host/"
        },
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
