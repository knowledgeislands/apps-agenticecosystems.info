        {
          "id": "industry.client",
          "slug": "client",
          "value": "yes",
          "detailHtml": "Terminal (CLI and TUI), desktop, web (the Webapp, off by default, and a dashboard), messaging apps, Android through Termux, and editors over ACP",
          "sources": [
            {
              "id": "S2",
