        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "unknown",
          "detailHtml": "The main agent &quot;coordinates their work and combines their results&quot;; no subagents messaging each other described",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "OpenAI, Agents API: multi-agent",
