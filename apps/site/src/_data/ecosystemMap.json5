    {
      "id": "product.grok-build",
      "slug": "grok-build",
      "name": "Grok Build",
      "title": "Grok Build (SpaceXSI)",
      "vendor": "SpaceXSI",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.grok-build.md",
      "summaryHtml": "Grok Build lets a developer hand coding work to Grok from the terminal. It is &quot;a coding agent for the terminal&quot;, used &quot;as an interactive TUI, headlessly in scripts or bots, or through the Agent Client Protocol (ACP) in other apps&quot; (<a href=\"https://docs.x.ai/build/overview\">S1</a>). SpaceXSI makes it: its pages carry that name, with the footer &quot;© 2026 SpaceX Super Intelligence LLC&quot;, and the repository's README calls it &quot;SpaceXAI's terminal-based AI coding agent&quot;, under the <code>xai-org</code> GitHub organisation (<a href=\"https://x.ai/news/grok-build-cli\">S2</a>, <a href=\"https://github.com/xai-org/grok-build\">S3</a>). It runs on macOS and Linux, and on Windows through PowerShell, Git Bash or WSL (<a href=\"https://docs.x.ai/build/overview\">S1</a>). It has been Apache-2.0 open source since 15 July 2026, and a user signs in with &quot;a SpaceXSI account&quot; or uses an API key (<a href=\"https://github.com/xai-org/grok-build\">S3</a>, <a href=\"https://x.ai/news/grok-build-open-source\">S4</a>, <a href=\"https://docs.x.ai/build/overview\">S1</a>). It installs by a shell script or, as an alternative, <code>npm install -g @xai-official/grok</code> (<a href=\"https://docs.x.ai/build/overview\">S1</a>, <a href=\"https://docs.x.ai/build/enterprise\">S16</a>). The latest stable release seen is 1.0.92, published on 20 November 2026 (<a href=\"https://www.npmjs.com/package/@xai-official/grok\">S18</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a <a href=\"/glossary/client/\">client</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
