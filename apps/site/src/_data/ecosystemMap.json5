    {
      "id": "product.ollama",
      "slug": "ollama",
      "name": "Ollama",
      "title": "Ollama (Ollama)",
      "vendor": "Ollama",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.ollama.md",
      "summaryHtml": "Ollama lets people run open models on their own computer or in Ollama's cloud, and point desktop apps, coding agents and their own applications at them: &quot;Use open models in your desktop apps and coding agents, or build them into your application&quot; (<a href=\"https://docs.ollama.com/\">S1</a>). The repository describes it as &quot;Get up and running with Kimi, GLM, MiniMax, DeepSeek, gpt-oss, Qwen, Gemma and other models&quot; (<a href=\"https://github.com/ollama/ollama\">S9</a>). It runs on macOS, Windows and Linux as an app, a CLI and a local API, with compatible OpenAI and Anthropic APIs (<a href=\"https://docs.ollama.com/quickstart\">S2</a>, <a href=\"https://ollama.com/download\">S12</a>, <a href=\"https://docs.ollama.com/\">S1</a>). The software is open source under the MIT licence (<a href=\"https://github.com/ollama/ollama\">S9</a>); cloud models are sold on Free, Pro ($20 a month), Max ($100 a month) and an early-access Team plan from $500 a month (<a href=\"https://ollama.com/pricing\">S11</a>). The latest release seen is v0.40.17, of 10 November 2026 (<a href=\"https://github.com/ollama/ollama/releases\">S10</a>). It is a model runtime, the neighbour of <a href=\"/glossary/model/\">model</a> rather than an agent harness: the pages read describe serving models and launching other agents, not running an agent loop of its own.",
      "instanceOf": [],
      "conformsTo": [],
