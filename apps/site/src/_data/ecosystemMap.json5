    {
      "id": "product.kimi-code",
      "slug": "kimi-code",
      "name": "Kimi Code",
      "title": "Kimi Code (Moonshot AI)",
      "vendor": "Moonshot AI",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.kimi-code.md",
      "summaryHtml": "Kimi Code lets a developer hand coding work to an agent that can &quot;read and edit code, run shell commands, search files, fetch web pages&quot; and choose its next step from the feedback: &quot;an AI coding agent that runs in your terminal&quot; (<a href=\"https://github.com/MoonshotAI/kimi-code\">S1</a>). Moonshot AI makes it, as <code>MoonshotAI/kimi-code</code>, under the MIT License; it presents it as &quot;the intelligent coding service for developers among Kimi membership benefits, based on Kimi's latest flagship model&quot; (translated from Chinese) (<a href=\"https://github.com/MoonshotAI/kimi-code\">S1</a>, <a href=\"https://www.kimi.com/code/docs/\">S2</a>). It runs as Kimi Code CLI in the terminal, a browser interface started by <code>kimi web</code>, Kimi Code Desktop on macOS, Windows and Linux, a VS Code extension, and in Zed and JetBrains through ACP (<a href=\"https://github.com/MoonshotAI/kimi-code\">S1</a>, <a href=\"https://www.kimi.com/code/docs/\">S2</a>, <a href=\"https://moonshotai.github.io/kimi-code/en/guides/web.html\">S14</a>, <a href=\"https://moonshotai.github.io/kimi-code/en/guides/ides.html\">S15</a>). It replaces the Python Kimi CLI, Apache-2.0 and archived on 23 September 2026 (<a href=\"https://github.com/MoonshotAI/kimi-cli\">S19</a>). The latest releases seen are Kimi Code CLI 2.7.2 and Kimi Code Desktop 1.4.2, both of 20 November 2026 (<a href=\"https://github.com/MoonshotAI/kimi-code/releases\">S3</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a <a href=\"/glossary/client/\">client</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
          "url": "/specifications/#spec-mcp"
        },
        {
          "id": "spec.acp",
          "label": "Agent Client Protocol (ACP)",
          "url": "/specifications/#spec-acp"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "Moonshot's own: <code>k3.1-pro</code>, <code>k3</code>, <code>kimi-for-coding</code> and others by membership tier; &quot;Kimi K3 works best with Kimi Code CLI as its agent framework&quot;. Other providers: <code>kimi</code>, <code>anthropic</code>, <code>openai</code> (&quot;OpenAI and compatible services, DeepSeek, Qwen, etc.&quot;), <code>openai_responses</code>, <code>bedrock</code>, <code>google-genai</code>, <code>vertexai</code>, and the models.dev catalogue; local models not named",
          "sources": [
            {
              "id": "S2",
              "titleHtml": "Moonshot AI, Kimi Code documentation overview, in Chinese, quoted in translation",
              "read": "2026-11-22",
              "url": "https://www.kimi.com/code/docs/"
            },
            {
              "id": "S18",
              "titleHtml": "Moonshot AI, MoonshotAI/Kimi-K3 repository",
              "read": "2026-11-22",
              "url": "https://github.com/MoonshotAI/Kimi-K3"
            },
            {
              "id": "S12",
              "titleHtml": "Moonshot AI, Providers and Models",
              "read": "2026-11-22",
              "url": "https://moonshotai.github.io/kimi-code/en/configuration/providers.html"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "&quot;persists every conversation as a &quot;session&quot;&quot;; <code>kimi --continue</code>, <code>kimi --session &lt;id&gt;</code>, <code>/sessions</code> (alias <code>/resume</code>) and forks",
          "sources": [
            {
              "id": "S5",
              "titleHtml": "Moonshot AI, Sessions and Context",
              "read": "2026-11-22",
              "url": "https://moonshotai.github.io/kimi-code/en/guides/sessions.html"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "yes",
          "detailHtml": "&quot;Dispatch built-in <code>coder</code>, <code>explore</code>, and <code>plan</code> subagents in isolated contexts&quot;; custom Markdown agents; &quot;Sub-agents support running in the background&quot;",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "Moonshot AI, MoonshotAI/kimi-code repository",
              "read": "2026-11-22",
              "url": "https://github.com/MoonshotAI/kimi-code"
            },
            {
              "id": "S6",
              "titleHtml": "Moonshot AI, Agents and Subagents",
              "read": "2026-11-22",
              "url": "https://moonshotai.github.io/kimi-code/en/customization/agents.html"
            }
          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "partial",
          "detailHtml": "Tower, &quot;an experimental multi-agent collaboration mode&quot;, off by default: the main agent &quot;becomes the tower and coordinates these workers&quot;, each in its own worktree; &quot;The tower routes messages&quot;, with no direct worker-to-worker messaging described",
          "sources": [
            {
              "id": "S7",
              "titleHtml": "Moonshot AI, Tower multi-agent collaboration",
              "read": "2026-11-22",
              "url": "https://moonshotai.github.io/kimi-code/en/guides/tower.html"
            }
          ]
        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "yes",
          "detailHtml": "&quot;<code>SKILL.md</code> consists of two parts: YAML frontmatter and a Markdown body&quot;, from <code>.kimi-code/skills/</code>, <code>.agents/skills/</code> and user folders; the page is titled &quot;Agent Skills&quot; but does not name the specification",
          "sources": [
            {
              "id": "S8",
              "titleHtml": "Moonshot AI, Agent Skills",
              "read": "2026-11-22",
              "url": "https://moonshotai.github.io/kimi-code/en/customization/skills.html"
            }
          ]
        },
        {
          "id": "industry.instruction-file",
          "slug": "instruction-file",
          "value": "yes",
          "detailHtml": "<code>AGENTS.md</code> or <code>.kimi-code/AGENTS.md</code> in the project, <code>$KIMI_CODE_HOME/AGENTS.md</code> and <code>~/.agents/AGENTS.md</code> globally, &quot;injected into the prompt as reference data&quot;",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "Moonshot AI, Agents and Subagents",
              "read": "2026-11-22",
              "url": "https://moonshotai.github.io/kimi-code/en/customization/agents.html"
            }
          ]
        },
        {
          "id": "industry.plugin",
          "slug": "plugin",
          "value": "yes",
          "detailHtml": "Plugins &quot;can add Agent Skills, custom agents&quot;, hooks, commands and MCP servers; installed from &quot;a local directory, zip URL, or GitHub repository URL&quot; or the official marketplace",
          "sources": [
            {
              "id": "S9",
              "titleHtml": "Moonshot AI, Plugins",
              "read": "2026-11-22",
              "url": "https://moonshotai.github.io/kimi-code/en/customization/plugins.html"
            }
          ]
        },
        {
          "id": "spec.mcp",
          "slug": "mcp",
          "value": "yes",
          "detailHtml": "stdio, HTTP and legacy HTTP+SSE servers, OAuth by <code>/mcp-config login</code>, user and project <code>mcp.json</code>",
          "sources": [
            {
              "id": "S10",
              "titleHtml": "Moonshot AI, Model Context Protocol",
              "read": "2026-11-22",
              "url": "https://moonshotai.github.io/kimi-code/en/customization/mcp.html"
            }
          ]
        },
        {
          "id": "industry.environment",
          "slug": "environment",
          "value": "yes",
          "detailHtml": "<code>container</code>: remote environments run tools on an SSH host or &quot;in a Docker-compatible container&quot;, with &quot;no silent fallback to your machine&quot;; no local sandbox documented, permission modes <code>manual</code>, <code>yolo</code> and <code>auto</code>",
          "sources": [
            {
              "id": "S13",
              "titleHtml": "Moonshot AI, Remote environments",
              "read": "2026-11-22",
              "url": "https://moonshotai.github.io/kimi-code/en/guides/remote-environment.html"
