    {
      "id": "product.copilot-studio",
      "slug": "copilot-studio",
      "name": "Copilot Studio",
      "title": "Copilot Studio (Microsoft)",
      "vendor": "Microsoft",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.copilot-studio.md",
      "summaryHtml": "Copilot Studio lets an organisation build agents and workflows, &quot;connect them to your organization's data and systems, and publish them to the channels where your users already work&quot;: &quot;a graphical, low-code studio for building and managing AI-powered agents and workflows&quot; (<a href=\"https://learn.microsoft.com/en-us/microsoft-copilot-studio/fundamentals-what-is-copilot-studio\">S1</a>). Microsoft makes it. What is built runs on one of its harnesses, &quot;the engine that carries out the work behind the scenes&quot;: the Microsoft Copilot harness, the Customer Conversation harness, in preview, and the standard harness (<a href=\"https://learn.microsoft.com/en-us/microsoft-copilot-studio/fundamentals-what-is-copilot-studio\">S1</a>, <a href=\"https://learn.microsoft.com/en-us/microsoft-copilot-studio/harnesses-overview\">S2</a>, <a href=\"https://learn.microsoft.com/en-us/microsoft-copilot-studio/whats-new\">S5</a>). It is a web app at <code>copilotstudio.microsoft.com</code>, with a Visual Studio Code extension, and its agents work &quot;across Microsoft Teams, Microsoft Copilot, websites, mobile apps, and other channels&quot; (<a href=\"https://learn.microsoft.com/en-us/microsoft-copilot-studio/fundamentals-what-is-copilot-studio\">S1</a>, <a href=\"https://learn.microsoft.com/en-us/microsoft-copilot-studio/whats-new\">S5</a>). It is billed in Copilot Credits by usage for the Microsoft Copilot and Customer Conversation harnesses, and by licence for the standard harness (<a href=\"https://learn.microsoft.com/en-us/microsoft-copilot-studio/harnesses-overview\">S2</a>). Microsoft publishes no version numbers; the latest monthly entry in its what's-new page is October 2026 (<a href=\"https://learn.microsoft.com/en-us/microsoft-copilot-studio/whats-new\">S5</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a>, in the maker's own word. Its skills follow the <a href=\"/specifications/#spec-agent-skills\">Agent Skills specification</a>. Its maker's own words for it are on the vendor card <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/vendors/microsoft/microsoft.copilot.md\">Copilot (Microsoft)</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        }
      ],
      "conformsTo": [
