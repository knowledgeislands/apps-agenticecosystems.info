    {
      "id": "product.openai-agents-api",
      "slug": "openai-agents-api",
      "name": "OpenAI Agents API",
      "title": "OpenAI Agents API (OpenAI)",
      "vendor": "OpenAI",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.openai-agents-api.md",
      "summaryHtml": "The OpenAI Agents API lets a developer run long-running agents without building or hosting the agent loop: it &quot;gives your application access to the Codex harness through an OpenAI-managed API&quot;, and &quot;OpenAI manages sessions, orchestration, context compaction, and recovery while your application provides tools and chooses its execution environment&quot; (<a href=\"https://developers.openai.com/api/docs/guides/agents-api/overview\">S1</a>). OpenAI makes it, and &quot;The Agents API is powered by the open-source Codex harness&quot; (<a href=\"https://openai.com/index/introducing-the-agents-api/\">S2</a>). It is used through the OpenAI API and its SDKs, <code>client.beta.agents.sessions</code>, behind the <code>OpenAI-Beta: agents=v1</code> header, and is in public beta, so its rows are <code>partial</code> (<a href=\"https://developers.openai.com/api/docs/guides/agents-api/overview\">S1</a>, <a href=\"https://developers.openai.com/api/docs/guides/agents-api/sessions\">S3</a>, <a href=\"https://developers.openai.com/api/docs/changelog\">S12</a>); Amazon Bedrock Managed Agents, &quot;powered by OpenAI&quot;, adapts it for AWS as a separate service (<a href=\"https://developers.openai.com/api/docs/guides/agents-api/bedrock-managed-agents\">S11</a>). It is a paid service with &quot;no additional fees&quot;: model usage at API rates, tools at their rates and hosted sandboxes at container rates; no licence is stated on the pages read (<a href=\"https://developers.openai.com/api/docs/guides/agents-api/overview\">S1</a>, <a href=\"https://openai.com/index/introducing-the-agents-api/\">S2</a>). It launched in public beta on 10 September 2026, and the latest change seen is of 30 October 2026; the API carries no product version number (<a href=\"https://developers.openai.com/api/docs/changelog\">S12</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and the <a href=\"/glossary/agent-host/\">agent host</a> of its sessions, the harness being &quot;The OpenAI-hosted Codex instance that runs the model and tool loop and maintains the agent’s session&quot; (<a href=\"https://developers.openai.com/api/docs/guides/agents-api/architecture\">S4</a>). Its maker's own words for it are on the vendor card <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/vendors/openai/openai.harness.md\">Harness (OpenAI)</a>. It is separate from the OpenAI Agents SDK, whose loop runs inside the developer's application (<a href=\"https://developers.openai.com/api/docs/guides/agents-api/overview\">S1</a>).",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.agent-host",
          "label": "Agent host",
          "url": "/glossary/agent-host/"
        }
      ],
      "conformsTo": [],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "partial",
          "detailHtml": "Beta. OpenAI models through the OpenAI API, <code>gpt-6-astra</code> in the examples, set per session; no list of supported models found",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "OpenAI, Agents API overview",
