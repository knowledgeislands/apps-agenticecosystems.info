    {
      "id": "product.pi",
      "slug": "pi",
      "name": "Pi",
      "title": "Pi (Earendil)",
      "vendor": "Earendil",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.pi.md",
      "summaryHtml": "Pi lets a developer shape a coding agent to their own way of working: &quot;Pi is a minimal, extensible agent harness that you can make your own&quot;, to be customised &quot;with extensions, skills, prompt templates, and themes&quot; and shared as Pi packages (<a href=\"https://github.com/earendil-works/pi\">S2</a>). Earendil makes it: pi.dev credits &quot;Earendil Inc. &amp; Contributors&quot;, earendil.com says &quot;Earendil crafts tools to harness AI with Pi and Lefos&quot;, and the repository sits in the <code>earendil-works</code> GitHub organisation (<a href=\"https://pi.dev\">S1</a>, <a href=\"https://earendil.com/\">S3</a>, <a href=\"https://github.com/earendil-works/pi\">S2</a>). It runs as the <code>pi</code> command on macOS, Linux and Windows, interactively in a terminal interface, in print or JSON mode for scripts, over RPC and through a TypeScript SDK (<a href=\"https://github.com/earendil-works/pi\">S2</a>, <a href=\"https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/how-pi-works.md\">S15</a>). It is MIT open source, the licence held by Mario Zechner; models come from a provider subscription or API key the user connects (<a href=\"https://pi.dev\">S1</a>, <a href=\"https://github.com/earendil-works/pi/blob/main/LICENSE\">S21</a>, <a href=\"https://github.com/earendil-works/pi\">S2</a>). The latest release seen is v1.6.0, of 20 November 2026 (<a href=\"https://github.com/earendil-works/pi/releases/tag/v1.6.0\">S4</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a <a href=\"/glossary/client/\">client</a>. Its skills follow the <a href=\"/specifications/#spec-agent-skills\">Agent Skills specification</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
          "url": "/specifications/#spec-mcp"
        },
        {
          "id": "spec.agent-skills",
          "label": "Agent Skills specification",
          "url": "/specifications/#spec-agent-skills"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "Several providers, among them Anthropic, OpenAI, Google Gemini, DeepSeek, Mistral, GitHub Copilot and OpenRouter, by <code>/login</code> or API key; local GGUF models through the llama.cpp router",
          "sources": [
            {
              "id": "S10",
              "titleHtml": "Earendil, Pi docs: Providers",
              "read": "2026-11-22",
              "url": "https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/providers.md"
            },
            {
              "id": "S11",
              "titleHtml": "Earendil, Pi docs: Local Models with llama.cpp",
              "read": "2026-11-22",
              "url": "https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/llama-cpp.md"
            },
            {
              "id": "S4",
              "titleHtml": "Earendil, release v1.6.0",
              "read": "2026-11-22",
              "url": "https://github.com/earendil-works/pi/releases/tag/v1.6.0"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "&quot;Pi saves sessions automatically&quot;; <code>--continue</code>, <code>--resume</code> and <code>/resume</code> reopen them, stored as trees in JSONL files with <code>/tree</code>, <code>/fork</code> and <code>/clone</code>",
          "sources": [
            {
              "id": "S9",
              "titleHtml": "Earendil, Pi docs: Sessions and Context",
              "read": "2026-11-22",
              "url": "https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/sessions.md"
            },
            {
              "id": "S15",
              "titleHtml": "Earendil, Pi docs: How Pi Works",
              "read": "2026-11-22",
              "url": "https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/how-pi-works.md"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "partial",
          "detailHtml": "Pi &quot;skips features like sub-agents and plan mode&quot;; its subagent example extension runs each subagent &quot;in a separate <code>pi</code> process&quot;, or a package adds them",
          "sources": [
            {
              "id": "S2",
              "titleHtml": "Earendil, earendil-works/pi repository README",
              "read": "2026-11-22",
              "url": "https://github.com/earendil-works/pi"
            },
            {
              "id": "S17",
              "titleHtml": "Earendil, Pi subagent example extension README",
              "read": "2026-11-22",
              "url": "https://github.com/earendil-works/pi/tree/main/packages/coding-agent/examples/extensions/subagent"
            }
          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "unknown",
          "detailHtml": "pi.dev says &quot;Spawn Pi instances via tmux&quot;; nothing read describes sessions working as a team",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "Earendil, Pi home (pi.dev)",
              "read": "2026-11-22",
              "url": "https://pi.dev"
            }
          ]
        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "yes",
          "detailHtml": "<code>SKILL.md</code> folders in user and project skills folders and <code>.agents/skills</code>, loaded on demand; &quot;Pi implements the Agent Skills specification&quot;",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "Earendil, Pi docs: Skills",
              "read": "2026-11-22",
              "url": "https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/skills.md"
            }
          ]
        },
        {
          "id": "industry.instruction-file",
          "slug": "instruction-file",
          "value": "yes",
          "detailHtml": "<code>AGENTS.md</code>, <code>AGENTS.override.md</code> or <code>CLAUDE.md</code> from the agent folder, the working folder and its parents; <code>SYSTEM.md</code> and <code>APPEND_SYSTEM.md</code> replace or extend the system prompt",
          "sources": [
            {
              "id": "S7",
              "titleHtml": "Earendil, Pi docs: Configuration",
              "read": "2026-11-22",
              "url": "https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/configuration.md"
            },
            {
              "id": "S1",
              "titleHtml": "Earendil, Pi home (pi.dev)",
              "read": "2026-11-22",
              "url": "https://pi.dev"
            }
          ]
        },
        {
          "id": "industry.plugin",
          "slug": "plugin",
          "value": "yes",
          "detailHtml": "Pi packages &quot;install and distribute extensions, skills, prompt templates, and themes as one unit&quot;, from npm, Git or a local path",
          "sources": [
            {
              "id": "S12",
              "titleHtml": "Earendil, Pi docs: Pi Packages",
              "read": "2026-11-22",
              "url": "https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/packages.md"
            }
          ]
        },
        {
          "id": "spec.mcp",
          "slug": "mcp",
          "value": "yes",
          "detailHtml": "&quot;Pi connects to Model Context Protocol servers over stdio or streamable HTTP&quot;, with OAuth; &quot;MCP is built in&quot;",
          "sources": [
            {
              "id": "S8",
              "titleHtml": "Earendil, Pi docs: MCP Servers",
              "read": "2026-11-22",
              "url": "https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/mcp.md"
            },
            {
              "id": "S1",
              "titleHtml": "Earendil, Pi home (pi.dev)",
              "read": "2026-11-22",
              "url": "https://pi.dev"
            },
            {
