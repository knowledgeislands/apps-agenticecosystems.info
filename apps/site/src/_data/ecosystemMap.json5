    {
      "id": "product.codex",
      "slug": "codex",
      "name": "Codex",
      "title": "Codex (OpenAI)",
      "vendor": "OpenAI",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.codex.md",
      "summaryHtml": "Codex lets a developer give coding work to an OpenAI agent, locally or in the cloud. OpenAI makes it: the CLI is &quot;a coding agent from OpenAI that runs locally on your computer&quot;, with a desktop app, an IDE extension for VS Code, Cursor and Windsurf, and Codex Web, the &quot;cloud-based agent&quot; (<a href=\"https://github.com/openai/codex\">S8</a>); the ChatGPT mobile app can drive a paired desktop (<a href=\"https://learn.chatgpt.com/docs/remote-connections\">S7</a>). The CLI is Apache-2.0 open source, used through a ChatGPT plan or an API key (<a href=\"https://github.com/openai/codex\">S8</a>). The latest stable CLI seen is 0.171.0, of 20 November 2026 (<a href=\"https://github.com/openai/codex/releases\">S9</a>), and the latest desktop app 26.1111, of 12 November 2026 (<a href=\"https://learn.chatgpt.com/docs/changelog\">S6</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a <a href=\"/glossary/client/\">client</a>. Its skills follow the <a href=\"/specifications/#spec-agent-skills\">Agent Skills specification</a>. Its maker's own words for it are on the vendor card <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/vendors/openai/openai.codex.md\">Codex (OpenAI)</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
          "url": "/specifications/#spec-mcp"
        },
        {
          "id": "spec.agent-skills",
          "label": "Agent Skills specification",
          "url": "/specifications/#spec-agent-skills"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
