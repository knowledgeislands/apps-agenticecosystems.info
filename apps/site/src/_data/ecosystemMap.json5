    {
      "id": "product.zed",
      "slug": "zed",
      "name": "Zed",
      "title": "Zed (Zed Industries)",
      "vendor": "Zed Industries",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.zed.md",
      "summaryHtml": "Zed lets developers write code with agents in a fast, shared editor: &quot;a high-performance, multiplayer code editor from the creators of Atom and Tree-sitter&quot; (<a href=\"https://github.com/zed-industries/zed\">S11</a>). Zed Industries, Inc. makes it (<a href=\"https://github.com/zed-industries/zed\">S11</a>). Its Agent Panel runs Zed's own &quot;first-party agent&quot;, an <a href=\"/glossary/agent-harness/\">agent harness</a>, or External Agents over ACP, so Zed is also their <a href=\"/glossary/client/\">client</a> and <a href=\"/glossary/agent-host/\">agent host</a> (<a href=\"https://zed.dev/docs/ai/agent-panel\">S2</a>, <a href=\"https://zed.dev/docs/ai/external-agents\">S1</a>). It runs as a desktop editor on macOS, Windows and Linux, with no web or mobile version offered (<a href=\"https://zed.dev/download\">S16</a>). It is &quot;GPL-3.0-or-later, with Apache-2.0 components where marked&quot;; Personal is free, Pro $10 a month and Business $30 a seat, and &quot;Zed does not charge for External Agents&quot; (<a href=\"https://github.com/zed-industries/zed\">S11</a>, <a href=\"https://zed.dev/pricing\">S10</a>, <a href=\"https://zed.dev/docs/ai/external-agents\">S1</a>). The latest stable release seen is 1.29.3, of 20 November 2026 (<a href=\"https://zed.dev/releases/stable\">S12</a>, <a href=\"https://github.com/zed-industries/zed/releases\">S13</a>). Its maker's own words for it are on the vendor card <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/vendors/zed/zed.zed.md\">Zed (Zed Industries)</a>.",
      "instanceOf": [
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        },
        {
          "id": "industry.agent-host",
          "label": "Agent host",
          "url": "/glossary/agent-host/"
        },
        {
