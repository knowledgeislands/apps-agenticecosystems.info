        {
          "id": "industry.session",
          "slug": "session",
          "value": "partial",
          "detailHtml": "Beta. A session is &quot;A durable instance of an agent that works on tasks and responds to input&quot;; the harness supports &quot;Resuming a session where it left off&quot;, and an idle session takes a new turn &quot;with the existing conversation&quot;",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "OpenAI, Agents API overview",
              "read": "2026-11-22",
              "url": "https://developers.openai.com/api/docs/guides/agents-api/overview"
