  "products": [
    {
      "id": "product.claude-code",
      "slug": "claude-code",
      "name": "Claude Code",
      "title": "Claude Code (Anthropic)",
      "vendor": "Anthropic",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.claude-code.md",
      "summaryHtml": "Claude Code lets a developer hand coding work to Claude: it is &quot;an agentic coding tool that reads your codebase, edits files, runs commands, and integrates with your development tools&quot; (<a href=\"https://code.claude.com/docs/en/overview\">S1</a>). Anthropic makes it, and its glossary says &quot;Claude Code is the harness; Claude is the model inside it&quot;, an <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/industry/industry.agent-harness.md\">agent harness</a> (<a href=\"https://code.claude.com/docs/en/glossary\">S2</a>). It runs as a terminal CLI, in VS Code, Cursor and JetBrains, in the Desktop app's Code tab, on the web and in the iOS and Android apps (<a href=\"https://code.claude.com/docs/en/overview\">S1</a>). It is proprietary, used under Anthropic's consumer or commercial terms with a Claude subscription or a Console account (<a href=\"https://code.claude.com/docs/en/overview\">S1</a>, <a href=\"https://code.claude.com/docs/en/legal-and-compliance\">S12</a>). The latest release seen is 2.1.330, of 20 November 2026 (<a href=\"https://code.claude.com/docs/en/changelog\">S3</a>). It is a <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/industry/industry.client.md\">client</a>. Its skills follow the <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/specs/agent-skills/spec.agent-skills.md\">Agent Skills specification</a>. Its maker's own words for it are on the vendor card <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/vendors/anthropic/anthropic.claude-code.md\">Claude Code (Anthropic)</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/industry/industry.agent-harness.md"
