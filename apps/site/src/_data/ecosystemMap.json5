    {
      "id": "product.grok-bot",
      "slug": "grok-bot",
      "name": "Grok Bot",
      "title": "Grok Bot (SpaceXSI)",
      "vendor": "SpaceXSI",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.grok-bot.md",
      "summaryHtml": "Grok Bot lets a person or a team hand ongoing work to named AI teammates that keep going while they are away: &quot;Grok Bot is your proactive AI teammate&quot;, giving &quot;Bots that do work for you on a cloud computer they share&quot; (<a href=\"https://docs.x.ai/grok-bot/overview\">S1</a>, <a href=\"https://docs.x.ai/grok-bot/get-started\">S2</a>). SpaceXSI makes it: its docs carry &quot;© 2026 SpaceX Super Intelligence LLC&quot;, and they set it apart from the Grok chat app, &quot;Grok (the chat app from SpaceXSI) and Grok Bot are two different apps&quot;; it &quot;signs in with your Cursor account&quot; (<a href=\"https://docs.x.ai/grok-bot/faq\">S4</a>, <a href=\"https://x.ai/news/introducing-grok-bot\">S10</a>). It runs as a desktop app on macOS (Apple silicon and Intel), Windows (x64 and Arm64) and Linux (x64 and Arm64), with companion apps for iOS and Android, in X Chat and on X, and as Team Bots in Slack and Microsoft Teams (<a href=\"https://docs.x.ai/grok-bot/get-started\">S2</a>, <a href=\"https://docs.x.ai/grok-bot/mobile\">S9</a>, <a href=\"https://docs.x.ai/grok-bot/faq\">S4</a>, <a href=\"https://x.ai/news/grok-bot-1-0\">S11</a>). No licence is stated on the pages read; it comes with Premium, Super and Ultra on The X Subscription, paid legacy Cursor plans, or a linked SuperGrok or X Premium+ subscription (<a href=\"https://docs.x.ai/grok-bot/get-started\">S2</a>). It launched in beta on 11 August 2026 and reached 1.0 on 11 November; the latest release seen is the iOS app 1.27.0, of 19 November 2026 (<a href=\"https://x.ai/news/introducing-grok-bot\">S10</a>, <a href=\"https://x.ai/news/grok-bot-1-0\">S11</a>, <a href=\"https://apps.apple.com/us/app/grok-bot/id6794501026\">S12</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a <a href=\"/glossary/client/\">client</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
          "url": "/specifications/#spec-mcp"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "&quot;Grok Bot picks the model for each task, and there is no model picker&quot;: &quot;a first-party SpaceXSI model or a third-party model from a provider on the sub-processor list&quot;",
          "sources": [
            {
              "id": "S4",
              "titleHtml": "SpaceXSI, Grok Bot FAQ",
              "read": "2026-11-22",
              "url": "https://docs.x.ai/grok-bot/faq"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "&quot;The same Bots and conversations sync across your signed-in devices&quot;; work runs in the cloud, and closing the app, laptop or phone &quot;does not stop a background turn or routine&quot;",
          "sources": [
            {
              "id": "S4",
              "titleHtml": "SpaceXSI, Grok Bot FAQ",
              "read": "2026-11-22",
              "url": "https://docs.x.ai/grok-bot/faq"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "partial",
          "detailHtml": "Only by handing work out: Bots &quot;can also hand coding work to Cursor Cloud Agents and attach the results to their reply&quot;",
          "sources": [
            {
              "id": "S3",
              "titleHtml": "SpaceXSI, How Grok Bot works",
              "read": "2026-11-22",
              "url": "https://docs.x.ai/grok-bot/how-grok-bot-works"
            }
          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "yes",
          "detailHtml": "Several Bots in a group chat, a primary Bot coordinating the others; a Bot can &quot;message another Bot to hand off work&quot;; Team Bots are shared by everyone on a team",
