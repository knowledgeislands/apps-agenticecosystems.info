    {
      "id": "product.zcode",
      "slug": "zcode",
      "name": "ZCode",
      "title": "ZCode (Z.ai)",
      "vendor": "Z.ai",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.zcode.md",
      "summaryHtml": "ZCode lets a developer hand long, multi-step coding work to an agent and follow it from the desk, a browser, a phone or a chat app: &quot;an Agentic Development Environment (ADE) built to bring GLM-5.3 into real coding workflows&quot; (<a href=\"https://zcode.z.ai/en/docs/welcome\">S1</a>). Z.ai makes it, as &quot;Z.ai's coding agent harness&quot; in the <code>zai-org/ZCode</code> repository, under the Apache License 2.0; its Chinese home page calls it &quot;the official GLM-5.3 harness&quot; (translated) and its legal owner is Beijing Zhipu Huazhang Technology (<a href=\"https://github.com/zai-org/ZCode\">S2</a>, <a href=\"https://zcode.z.ai/\">S4</a>). It runs as a desktop app for macOS, Windows and Linux (Linux in beta), and the open-source build adds a terminal TUI and a browser interface; a phone and WeChat or Feishu bots drive desktop sessions remotely (<a href=\"https://github.com/zai-org/ZCode\">S2</a>, <a href=\"https://zcode.z.ai/\">S4</a>, <a href=\"https://zcode.z.ai/en/docs/remote-control\">S12</a>, <a href=\"https://zcode.z.ai/en/docs/bot-channel\">S13</a>). The app is free, with GLM models through the GLM Coding Plan, a Z.ai or BigModel account, or an API key (<a href=\"https://zcode.z.ai/en/docs/configuration\">S5</a>, <a href=\"https://docs.z.ai/devpack/tool/zcode\">S18</a>). The latest release seen is 3.18.2, of 13 November 2026 by the changelog (<a href=\"https://zcode.z.ai/en/changelog\">S3</a>, <a href=\"https://github.com/zai-org/ZCode/releases\">S20</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a <a href=\"/glossary/client/\">client</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
          "url": "/specifications/#spec-mcp"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "Built-in GLM-5.3 and GLM-5.3-Flash; added providers Anthropic, OpenAI, OpenRouter, Moonshot, MiniMax and Xiaomi MiMo, and any Anthropic- or OpenAI-compatible service, including &quot;self-hosted services on a private network&quot;",
          "sources": [
            {
              "id": "S5",
              "titleHtml": "Z.ai, ZCode docs: Connect Models",
              "read": "2026-11-22",
              "url": "https://zcode.z.ai/en/docs/configuration"
            },
            {
              "id": "S19",
              "titleHtml": "Z.AI Developer Docs, GLM Coding Plan overview",
              "read": "2026-11-22",
              "url": "https://docs.z.ai/devpack/overview"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "Tasks kept in the sidebar, archived and forked; the CLI's <code>--resume</code> and <code>--continue</code> reload a session's history from its SQLite store",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "Z.ai, ZCode docs: ZCode Agent",
              "read": "2026-11-22",
              "url": "https://zcode.z.ai/en/docs/agents"
            },
            {
              "id": "S3",
              "titleHtml": "Z.ai, ZCode changelog",
              "read": "2026-11-22",
              "url": "https://zcode.z.ai/en/changelog"
            },
            {
              "id": "S16",
              "titleHtml": "Z.ai, ZCode CLI guide: Sessions (Chinese, quoted in translation)",
              "read": "2026-11-22",
              "url": "https://github.com/zai-org/ZCode/blob/main/apps/zcode-cli/docs/usage/06-sessions.md"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "yes",
          "detailHtml": "Built-in general-purpose and Explore subagents launched &quot;through the Agent tool&quot;; custom subagents in beta; &quot;a subagent cannot spawn subagents of its own&quot;",
          "sources": [
            {
              "id": "S7",
              "titleHtml": "Z.ai, ZCode docs: Subagents",
              "read": "2026-11-22",
              "url": "https://zcode.z.ai/en/docs/subagents"
            }
          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "unknown",
          "detailHtml": "The home page claims &quot;multi-agent collaboration to complete complex goals&quot; (translated); the pages read describe subagents reporting to the main agent, with no peer messaging",
          "sources": [
            {
              "id": "S4",
              "titleHtml": "Z.ai, ZCode home page (Chinese, quoted in translation)",
              "read": "2026-11-22",
              "url": "https://zcode.z.ai/"
            },
            {
              "id": "S7",
              "titleHtml": "Z.ai, ZCode docs: Subagents",
              "read": "2026-11-22",
              "url": "https://zcode.z.ai/en/docs/subagents"
            }
          ]
        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "yes",
          "detailHtml": "<code>SKILL.md</code> folders in <code>~/.zcode/skills/</code> and the workspace's <code>.zcode/skills/</code>, metadata injected and bodies &quot;loaded on demand&quot;; imports from Claude Code, Codex CLI and others; the pages read do not name the specification",
          "sources": [
            {
              "id": "S8",
              "titleHtml": "Z.ai, ZCode docs: Skill",
              "read": "2026-11-22",
              "url": "https://zcode.z.ai/en/docs/skill"
            }
          ]
        },
        {
          "id": "industry.instruction-file",
          "slug": "instruction-file",
          "value": "yes",
          "detailHtml": "<code>~/.zcode/AGENTS.md</code> then the workspace's <code>AGENTS.md</code>; it &quot;does not merge multiple AGENTS.md files across directory levels&quot;; <code>CLAUDE.md</code> only as a one-time migration source",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "Z.ai, ZCode docs: ZCode Agent",
              "read": "2026-11-22",
              "url": "https://zcode.z.ai/en/docs/agents"
            }
          ]
        },
        {
          "id": "industry.plugin",
          "slug": "plugin",
          "value": "yes",
          "detailHtml": "Plugins bundle skills, commands, subagents, MCP servers and hooks, from a curated store or added marketplaces; ZCode &quot;preloads the Claude Code marketplace&quot;",
          "sources": [
            {
              "id": "S9",
              "titleHtml": "Z.ai, ZCode docs: Plugin",
              "read": "2026-11-22",
              "url": "https://zcode.z.ai/en/docs/plugin"
            }
          ]
        },
        {
          "id": "spec.mcp",
          "slug": "mcp",
          "value": "yes",
          "detailHtml": "stdio servers, with &quot;SSE and HTTP remote servers are also supported&quot;, OAuth for remote services, and import from Claude Code, Codex CLI and OpenCode configuration",
          "sources": [
            {
              "id": "S10",
              "titleHtml": "Z.ai, ZCode docs: MCP",
              "read": "2026-11-22",
              "url": "https://zcode.z.ai/en/docs/mcp-services"
            }
          ]
        },
        {
          "id": "industry.environment",
          "slug": "environment",
          "value": "yes",
          "detailHtml": "<code>container</code>, opt-in: a workspace in a &quot;Docker local container&quot;, or on an SSH host or in WSL, to &quot;isolate dependencies inside a local Docker container&quot;; otherwise on the desktop with permission modes, the CLI's plan mode &quot;not an OS-level read-only sandbox&quot; (translated)",
          "sources": [
            {
              "id": "S11",
              "titleHtml": "Z.ai, ZCode docs: Remote Development",
