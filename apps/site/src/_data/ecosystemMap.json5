        },
        {
          "id": "industry.environment",
          "slug": "environment",
          "value": "yes",
          "detailHtml": "<code>harness-sandbox</code>: an off-by-default local command sandbox, Seatbelt on macOS and Bubblewrap on Linux; <code>vendor-sandbox</code>: cloud sessions in &quot;a managed cloud sandbox&quot;",
          "sources": [
