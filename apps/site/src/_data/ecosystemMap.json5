              "url": "https://goose-docs.ai/docs/guides/context-engineering/using-goosehints"
            }
          ]
        },
        {
          "id": "industry.plugin",
          "slug": "plugin",
          "value": "yes",
          "detailHtml": "&quot;Plugins are packages that extend goose with reusable components&quot;, skills and hooks, installed with <code>goose plugin install</code>; no marketplace mentioned",
          "sources": [
            {
              "id": "S11",
              "titleHtml": "AAIF, Plugins",
              "read": "2026-11-22",
              "url": "https://goose-docs.ai/docs/guides/context-engineering/plugins"
            }
          ]
        },
        {
          "id": "spec.mcp",
          "slug": "mcp",
          "value": "yes",
          "detailHtml": "&quot;goose was one of the earliest adopters&quot;, with 70+ documented extensions and MCP Apps in the desktop app",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "AAIF, goose home",
              "read": "2026-11-22",
              "url": "https://goose-docs.ai/"
            }
          ]
        },
        {
          "id": "industry.environment",
          "slug": "environment",
          "value": "partial",
          "detailHtml": "<code>none</code> by default: the macOS seatbelt sandbox &quot;was experimental and has been removed&quot;, and the server process &quot;runs with the same permissions as your user account&quot;; <code>container</code> only through the Container Use MCP extension",
          "sources": [
