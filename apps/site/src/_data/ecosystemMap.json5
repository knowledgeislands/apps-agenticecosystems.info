          "slug": "client",
          "value": "yes",
          "detailHtml": "Terminal; web, on phones over LAN or Remote Control (<code>kimi rc</code>); Desktop; VS Code; Zed, JetBrains and Paseo through ACP",
          "sources": [
            {
