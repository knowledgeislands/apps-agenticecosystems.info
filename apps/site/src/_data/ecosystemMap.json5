          "value": "unknown",
          "detailHtml": "Not found; extensions are optional install extras and third-party adapters",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "OpenAI, OpenAI Agents SDK (Python docs introduction)",
              "read": "2026-11-22",
              "url": "https://openai.github.io/openai-agents-python/"
