      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "&quot;Frontier reasoning models from Google DeepMind and partner providers&quot;: Gemini 4 and 3.x, Claude Sonnet and Opus 5.5 and 4.6, GPT-OSS-120b, and an Orchestrator pairing a planner and an executor; own keys and local models not stated for the App or CLI, the SDK listing &quot;Local models&quot;",
          "sources": [
            {
              "id": "S3",
              "titleHtml": "Google, Antigravity models",
              "read": "2026-11-22",
              "url": "https://antigravity.google/docs/models/"
            },
            {
              "id": "S1",
              "titleHtml": "Google, Antigravity docs overview",
              "read": "2026-11-22",
              "url": "https://antigravity.google/docs/overview"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "CLI conversations scoped to the working folder, resumed from the Session Picker or <code>agy -c</code> / <code>agy --continue</code>; <code>/fork</code> &quot;clones your entire conversation history&quot; into a new session",
          "sources": [
            {
              "id": "S13",
              "titleHtml": "Google, Antigravity CLI: conversations",
              "read": "2026-11-22",
              "url": "https://antigravity.google/docs/cli/conversations/"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "yes",
          "detailHtml": "&quot;The parent agent calls the <code>invoke_subagent</code> tool to spawn a new concurrent session&quot;; built-in <code>research</code>, <code>browser</code> and <code>self</code> types, custom Markdown agents, optional isolated Git worktrees, nesting to 10 levels",
          "sources": [
            {
              "id": "S4",
              "titleHtml": "Google, Antigravity subagents",
              "read": "2026-11-22",
              "url": "https://antigravity.google/docs/subagents/"
            }
          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "yes",
          "detailHtml": "<code>/swarm</code> workers &quot;coordinate on one shared message board with <code>@mentions</code>&quot;, on all plans; <code>/teamwork</code> runs &quot;a collaborative multi-agent team&quot; with Sentinel and Project Orchestrator leads, on paid plans",
          "sources": [
            {
              "id": "S4",
              "titleHtml": "Google, Antigravity subagents",
              "read": "2026-11-22",
              "url": "https://antigravity.google/docs/subagents/"
            },
            {
              "id": "S5",
              "titleHtml": "Google, Antigravity <code>/teamwork</code>",
              "read": "2026-11-22",
              "url": "https://antigravity.google/docs/teamwork/"
            }
          ]
        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "yes",
          "detailHtml": "<code>SKILL.md</code> folders in <code>.agents/skills</code>, parent folders and <code>~/.gemini/config/skills</code>, by progressive disclosure; &quot;Skills are an open standard&quot;, linking agentskills.io, without naming the specification",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "Google, Antigravity skills",
              "read": "2026-11-22",
              "url": "https://antigravity.google/docs/skills/"
            }
          ]
        },
        {
          "id": "industry.instruction-file",
          "slug": "instruction-file",
          "value": "yes",
          "detailHtml": "<code>AGENTS.md</code> or <code>GEMINI.md</code> in the workspace and each parent to the repository root, <code>.agents/rules/*.md</code>, and global files under <code>~/.gemini</code>; &quot;Antigravity doesn't load rules from subfolders below the workspace folder&quot;",
          "sources": [
            {
              "id": "S7",
              "titleHtml": "Google, Antigravity rules",
              "read": "2026-11-22",
              "url": "https://antigravity.google/docs/rules/"
            }
          ]
        },
        {
          "id": "industry.plugin",
          "slug": "plugin",
          "value": "yes",
          "detailHtml": "A <code>plugin.json</code> bundle of &quot;skills, Model Context Protocol (MCP) servers, custom agents and subagents, rules&quot; and hooks, from the Antigravity Marketplace, GitHub or a folder; imports from <code>~/.gemini/extensions/</code> or <code>~/.claude/plugins/</code>",
          "sources": [
            {
              "id": "S8",
              "titleHtml": "Google, Antigravity plugins",
              "read": "2026-11-22",
              "url": "https://antigravity.google/docs/plugins/"
            }
          ]
        },
        {
          "id": "spec.mcp",
          "slug": "mcp",
          "value": "yes",
          "detailHtml": "Local <code>stdio</code> servers and remote servers that &quot;must use the Streamable HTTP transport&quot;, with OAuth 2.0 and PKCE handled automatically",
          "sources": [
            {
              "id": "S9",
              "titleHtml": "Google, Antigravity MCP",
              "read": "2026-11-22",
              "url": "https://antigravity.google/docs/mcp/"
            }
          ]
        },
        {
          "id": "industry.environment",
          "slug": "environment",
          "value": "yes",
          "detailHtml": "<code>harness-sandbox</code>: &quot;OS-level container boundaries&quot; from namespaces, Seatbelt or a Windows AppContainer, on by default in the App's Default preset, off by default in the CLI unless <code>auto</code> mode; Remote Agents run in an &quot;isolated, Google-managed remote environment&quot;, <code>vendor-sandbox</code>, &quot;rolling out gradually&quot; to Pro and Ultra",
          "sources": [
            {
              "id": "S10",
              "titleHtml": "Google, Antigravity sandbox",
              "read": "2026-11-22",
