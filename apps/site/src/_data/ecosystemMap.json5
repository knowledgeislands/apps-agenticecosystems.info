              "url": "https://hermes-agent.nousresearch.com/docs/user-guide/messaging/a2a"
            }
          ]
        },
        {
          "id": "industry.cross-session-messaging",
          "slug": "cross-session-messaging",
          "value": "yes",
          "detailHtml": "&quot;every Bot Chat carries the <code>message_agent</code> tool&quot;, delivering &quot;into the teammate's canonical Bot Chat&quot;; on a headless install it must be enabled by hand",
          "sources": [
            {
              "id": "S7",
              "titleHtml": "Nous Research, Hermes Agent docs: Bot Mode",
              "read": "2026-11-22",
