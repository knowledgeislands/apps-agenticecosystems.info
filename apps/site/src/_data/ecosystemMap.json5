              "read": "2026-11-22",
              "url": "https://opencode.ai/docs/api/"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "yes",
          "detailHtml": "The <code>subagent</code> tool runs child sessions with fresh context; &quot;Subagents always run in the background&quot; since v2.3.0",
          "sources": [
            {
              "id": "S5",
              "titleHtml": "Anomaly, Agents",
