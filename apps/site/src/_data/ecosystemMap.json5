    {
      "id": "product.orca",
      "slug": "orca",
      "name": "Orca",
      "title": "Orca (Stably AI)",
      "vendor": "Stably AI",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.orca.md",
      "summaryHtml": "Orca lets one person run many coding agents side by side, each in its own git worktree: &quot;the agent development environment&quot;, &quot;a desktop IDE for running multiple AI coding agents side by side&quot; (<a href=\"https://github.com/stablyai/orca\">S1</a>, <a href=\"https://orca.dev/\">S2</a>). Stably AI makes it, backed by Y Combinator, in the <code>stablyai</code> GitHub organisation (<a href=\"https://github.com/stablyai/orca\">S1</a>, <a href=\"https://orca.dev/\">S2</a>). It is an <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/industry/industry.agent-host.md\">agent host</a> for other makers' agent CLIs and a <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/industry/industry.client.md\">client</a> onto their sessions: an Electron desktop app for macOS, Windows and Linux, a phone companion, remote Orca servers, SSH machines and cloud VMs, and the <code>orca</code> CLI (<a href=\"https://github.com/stablyai/orca\">S1</a>, <a href=\"https://orca.dev/\">S2</a>, S10). It is MIT open source and free; its agents run on &quot;the Claude Code or Codex you already pay for&quot; (<a href=\"https://github.com/stablyai/orca\">S1</a>, <a href=\"https://orca.dev/\">S2</a>). The latest release seen is v1.4.269, of 21 November 2026, the version installed on sol (<a href=\"https://github.com/stablyai/orca/releases/tag/v1.4.269\">S7</a>, S10). Its maker's own words for it are on the vendor cards <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/vendors/orca/orca.app.md\">Orca app (Orca)</a> and <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/vendors/orca/orca.runtime.md\">Orca runtime (Orca)</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-host",
          "label": "Agent host",
          "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/industry/industry.agent-host.md"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/industry/industry.client.md"
        }
      ],
      "conformsTo": [],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "Whatever agent CLI is picked, &quot;Works with any CLI agent&quot;, among them Claude Code, Codex, Gemini CLI, Grok, OpenCode and Goose; <code>agent launch --model</code> takes a provider's model id",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "Stably AI, stablyai/orca README",
              "read": "2026-11-22",
              "url": "https://github.com/stablyai/orca"
            },
            {
              "id": "S2",
              "titleHtml": "Stably AI, Orca, the agent development environment",
              "read": "2026-11-22",
              "url": "https://orca.dev/"
            },
