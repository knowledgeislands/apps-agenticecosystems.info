  "products": [
    {
      "id": "product.antigravity",
      "slug": "antigravity",
      "name": "Antigravity",
      "title": "Antigravity (Google)",
      "vendor": "Google",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.antigravity.md",
      "summaryHtml": "Antigravity lets a developer hand coding work to agents, supporting &quot;both synchronous interactive pair-programming and asynchronous background agent workflows&quot;, with &quot;native agentic assistance across purpose-built product surfaces&quot; (<a href=\"https://antigravity.google/docs/overview\">S1</a>). Google makes it, and &quot;every Antigravity surface runs on a shared, highly optimized agent harness co-trained with Gemini models&quot; (<a href=\"https://antigravity.google/docs/overview\">S1</a>). It runs as the Antigravity App, &quot;a standalone desktop application for launching, orchestrating, and inspecting autonomous agent teams&quot;; the Antigravity CLI, <code>agy</code>, &quot;a keyboard-first terminal client&quot;; editor extensions for VS Code, Visual Studio, JetBrains, Zed, Xcode and Eclipse; a Python SDK; and any browser through Remote Control (<a href=\"https://antigravity.google/docs/overview\">S1</a>, <a href=\"https://antigravity.google/docs/remote-control/\">S15</a>). The pages read state no licence: it starts &quot;at $0/month on the Free plan&quot;, with Google AI Plus, Pro and Ultra for higher limits and Enterprise &quot;governed by the Google Cloud Terms of Service&quot; (<a href=\"https://antigravity.google/docs/overview\">S1</a>). Google announced the CLI as available to everyone on 19 May 2026, and from 18 June 2026 Gemini CLI stopped serving Google AI Pro, Ultra and free users, who move to it (<a href=\"https://developers.googleblog.com/an-important-update-transitioning-gemini-cli-to-antigravity-cli/\">S18</a>). The latest App release seen is v2.34.0, of 20 November 2026 (<a href=\"https://antigravity.google/docs/changelog/\">S2</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a>, an <a href=\"/glossary/agent-host/\">agent host</a> and a <a href=\"/glossary/client/\">client</a>. Its skills follow the <a href=\"/specifications/#spec-agent-skills\">Agent Skills specification</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.agent-host",
          "label": "Agent host",
          "url": "/glossary/agent-host/"
        },
