            {
              "id": "S5",
              "titleHtml": "SpaceXSI, Grok release notes",
              "read": "2026-11-22",
              "url": "https://grok.com/release-notes"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "unknown",
          "detailHtml": "Release notes name an &quot;Agent library — browse and select specialized agents&quot; and SuperGrok Heavy's &quot;other agents&quot;, without saying how they work",
          "sources": [
            {
