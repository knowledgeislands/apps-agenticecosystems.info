            }
          ]
        },
        {
          "id": "industry.instruction-file",
          "slug": "instruction-file",
          "value": "yes",
          "detailHtml": "&quot;goose looks for AGENTS.md then .goosehints files by default&quot;, global and nested; <code>CONTEXT_FILE_NAMES</code> adds others such as <code>CLAUDE.md</code>",
          "sources": [
            {
              "id": "S10",
              "titleHtml": "AAIF, Providing hints to goose",
