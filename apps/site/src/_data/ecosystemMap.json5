    {
      "id": "product.kiro",
      "slug": "kiro",
      "name": "Kiro",
      "title": "Kiro (Amazon Web Services)",
      "vendor": "Amazon Web Services",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.kiro.md",
      "summaryHtml": "Kiro helps developers build software &quot;from prototype to production&quot; with an agent that plans, implements and opens pull requests, from specs and steering they write once (<a href=\"https://kiro.dev/docs/\">S1</a>). &quot;Kiro is built and operated by a small, opinionated team within AWS&quot; (<a href=\"https://kiro.dev/about/\">S2</a>). It is &quot;an agentic AI engineering system available via an IDE, CLI, web interface, mobile app, and Kiro Crew&quot;, with &quot;one unified agent harness&quot; behind the IDE, the Kiro for VS Code extension, the CLI, the web and mobile (<a href=\"https://kiro.dev/faq/\">S30</a>, <a href=\"https://kiro.dev/docs/\">S1</a>); Kiro Crew, a persistent personal agent with its own installer, runs on the Kiro CLI (<a href=\"https://kiro.dev/docs/crew/\">S20</a>, <a href=\"https://kiro.dev/crew/\">S25</a>). The IDE and CLI are licensed as &quot;AWS Content&quot; under the AWS Customer Agreement, sold from a free tier to paid plans, while Kiro Crew is open source under Apache 2.0 (<a href=\"https://kiro.dev/license/\">S3</a>, <a href=\"https://kiro.dev/pricing/\">S4</a>, <a href=\"https://kiro.dev/crew/\">S25</a>). The latest releases seen are IDE 1.5.11 of 20 November 2026, CLI 3.5.0 of 17 November and Crew 0.13.0 of 19 November (<a href=\"https://kiro.dev/changelog/\">S5</a>, <a href=\"https://github.com/kirodotdev/KiroCrew/releases\">S26</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a <a href=\"/glossary/client/\">client</a>. Its skills follow the <a href=\"/specifications/#spec-agent-skills\">Agent Skills specification</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
          "url": "/specifications/#spec-mcp"
        },
        {
          "id": "spec.agent-skills",
          "label": "Agent Skills specification",
          "url": "/specifications/#spec-agent-skills"
        },
        {
          "id": "spec.acp",
          "label": "Agent Client Protocol (ACP)",
          "url": "/specifications/#spec-acp"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "Auto, &quot;Kiro's model router&quot;; Anthropic's Claude, OpenAI's GPT-5.6, xAI's Grok, Kimi, MiniMax, GLM, DeepSeek and Qwen; local models unknown",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "Kiro, Available models",
              "read": "2026-11-22",
              "url": "https://kiro.dev/docs/models/available-models/"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "The CLI &quot;automatically saves all chat sessions on every conversation turn&quot; and resumes them; cloud sessions can be resumed and steered from every surface",
          "sources": [
            {
              "id": "S7",
              "titleHtml": "Kiro, CLI: Session management",
              "read": "2026-11-22",
              "url": "https://kiro.dev/docs/cli/chat/session-management/"
            },
            {
              "id": "S8",
              "titleHtml": "Kiro, Cloud sessions",
              "read": "2026-11-22",
              "url": "https://kiro.dev/docs/cloud-sessions/"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "yes",
          "detailHtml": "&quot;Sub-agents let you hand off focused tasks to agents that run in their own isolated context&quot;, automatically or by name, in parallel, on every surface",
          "sources": [
            {
              "id": "S9",
              "titleHtml": "Kiro, Invoking as sub-agents",
              "read": "2026-11-22",
              "url": "https://kiro.dev/docs/custom-agents/subagents/"
            }
          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "partial",
          "detailHtml": "Workflows give work &quot;to a team of agents with a plan&quot;, each step in its own session; Crew's conductor delegates to workers that report back; no peer messaging described",
          "sources": [
            {
              "id": "S10",
              "titleHtml": "Kiro, Workflows",
              "read": "2026-11-22",
              "url": "https://kiro.dev/docs/workflows/"
            },
            {
              "id": "S21",
              "titleHtml": "Kiro, Crew: How bots work",
              "read": "2026-11-22",
              "url": "https://kiro.dev/docs/crew/bots/how-bots-work/"
            }
          ]
        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "yes",
          "detailHtml": "&quot;Skills are portable instruction packages that follow the open Agent Skills standard&quot;, in <code>.kiro/skills/</code> and <code>~/.kiro/skills/</code>",
          "sources": [
            {
              "id": "S11",
              "titleHtml": "Kiro, Agent Skills",
              "read": "2026-11-22",
              "url": "https://kiro.dev/docs/skills/"
            }
          ]
        },
        {
          "id": "industry.instruction-file",
          "slug": "instruction-file",
          "value": "yes",
          "detailHtml": "Steering in <code>.kiro/steering/</code> and <code>~/.kiro/steering/</code>; <code>AGENTS.md</code> at the root, in subdirectories and globally; <code>CLAUDE.md</code> not mentioned",
          "sources": [
            {
              "id": "S12",
              "titleHtml": "Kiro, Steering",
              "read": "2026-11-22",
              "url": "https://kiro.dev/docs/steering/"
            }
          ]
        },
        {
          "id": "industry.plugin",
          "slug": "plugin",
          "value": "yes",
          "detailHtml": "Powers package skills and MCP configuration, &quot;follow the Agent Plugins specification&quot;, and install from a marketplace or GitHub",
          "sources": [
            {
              "id": "S13",
              "titleHtml": "Kiro, Powers",
              "read": "2026-11-22",
              "url": "https://kiro.dev/docs/powers/"
            }
          ]
        },
        {
          "id": "spec.mcp",
          "slug": "mcp",
          "value": "yes",
          "detailHtml": "Local stdio and remote HTTP or SSE servers on every surface, with OAuth sign-in",
          "sources": [
            {
