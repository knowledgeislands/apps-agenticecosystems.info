            }
          ]
        },
        {
          "id": "industry.instruction-file",
          "slug": "instruction-file",
          "value": "yes",
          "detailHtml": "<code>.hermes.md</code>, <code>AGENTS.override.md</code>, <code>AGENTS.md</code>, <code>CLAUDE.md</code> and <code>.cursorrules</code>, first match wins; <code>AGENTS.md</code> merged from the git root down and found progressively in subfolders; a global <code>SOUL.md</code>",
          "sources": [
            {
              "id": "S9",
              "titleHtml": "Nous Research, Hermes Agent docs: Context Files",
              "read": "2026-11-22",
              "url": "https://hermes-agent.nousresearch.com/docs/user-guide/features/context-files"
            }
          ]
        },
        {
          "id": "industry.plugin",
          "slug": "plugin",
          "value": "yes",
          "detailHtml": "&quot;a plugin system for adding custom tools, hooks, and integrations without modifying core code&quot;; <code>hermes plugins install</code> from a catalogue or Git; the catalogue passed 1,050 entries in v0.23.0",
          "sources": [
            {
              "id": "S10",
              "titleHtml": "Nous Research, Hermes Agent docs: Plugins",
              "read": "2026-11-22",
