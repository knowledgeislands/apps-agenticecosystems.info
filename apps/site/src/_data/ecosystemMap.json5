              "read": "2026-11-22",
              "url": "https://opencode.ai/docs/skills"
            }
          ]
        },
        {
          "id": "industry.instruction-file",
          "slug": "instruction-file",
          "value": "yes",
          "detailHtml": "<code>AGENTS.md</code>, global then up and down the tree, with <code>CLAUDE.md</code> as fallback; an <code>instructions</code> list of files, globs or URLs",
          "sources": [
