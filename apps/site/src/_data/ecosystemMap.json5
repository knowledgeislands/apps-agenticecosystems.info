        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "partial",
          "detailHtml": "Beta. &quot;A custom skill is a directory containing a <code>SKILL.md</code> file&quot;, uploaded or found in a mounted repository's <code>.claude/skills</code>; the pages read link Anthropic's Agent Skills docs but do not name the specification",
          "sources": [
            {
              "id": "S10",
              "titleHtml": "Anthropic, Skills",
              "read": "2026-11-22",
              "url": "https://platform.claude.com/docs/en/managed-agents/skills"
            }
          ]
        },
        {
          "id": "industry.instruction-file",
          "slug": "instruction-file",
          "value": "unknown",
          "detailHtml": "Not found; the agent's system prompt is set on its definition",
