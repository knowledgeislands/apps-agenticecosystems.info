          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "yes",
          "detailHtml": "The agent &quot;can launch a subagent automatically&quot;; definitions in <code>.cursor/agents/</code>, <code>.claude/agents/</code> or <code>.codex/agents/</code>; worktree or cloud-VM isolation",
          "sources": [
