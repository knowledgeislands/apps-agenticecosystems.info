    {
      "id": "product.goose",
      "slug": "goose",
      "name": "goose",
      "title": "goose (Agentic AI Foundation)",
      "vendor": "Agentic AI Foundation",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.goose.md",
      "summaryHtml": "goose lets its users hand research, writing, automation, data analysis and coding to an agent on their own machine: &quot;goose is a general-purpose AI agent that runs on your machine&quot; (<a href=\"https://goose-docs.ai/\">S1</a>). The maker writes its name in lower case. Block donated it to the Agentic AI Foundation (AAIF) at the Linux Foundation, and on 7 April 2026 its repository moved from <code>block/goose</code> to the <code>aaif-goose</code> organisation (<a href=\"https://goose-docs.ai/blog/2026/04/07/goose-moves-to-aaif/\">S4</a>, <a href=\"https://github.com/aaif-goose/goose\">S2</a>). It runs as &quot;a native desktop app for macOS, Linux, and Windows&quot; and &quot;a full CLI&quot;, as an ACP server for editors, and in an experimental VS Code extension (<a href=\"https://goose-docs.ai/\">S1</a>, <a href=\"https://goose-docs.ai/docs/oi-kit/acp/\">S14</a>, <a href=\"https://goose-docs.ai/docs/experimental/vs-code-extension\">S15</a>). It is open source under Apache 2.0 (<a href=\"https://goose-docs.ai/\">S1</a>, <a href=\"https://github.com/aaif-goose/goose\">S2</a>). The latest release seen is v1.60.2, of 20 November 2026 (<a href=\"https://github.com/aaif-goose/goose/releases\">S3</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a <a href=\"/glossary/client/\">client</a>. Its skills follow the <a href=\"/specifications/#spec-agent-skills\">Agent Skills specification</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
