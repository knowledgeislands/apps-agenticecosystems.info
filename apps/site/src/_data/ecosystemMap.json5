    {
      "id": "product.jules",
      "slug": "jules",
      "name": "Jules",
      "title": "Jules (Google)",
      "vendor": "Google",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.jules.md",
      "summaryHtml": "Jules lets a developer hand off coding work, &quot;an experimental coding agent that helps you fix bugs, add documentation, and build new features&quot;, which &quot;integrates with GitHub, understands your codebase, and works autonomously&quot; (<a href=\"https://jules.google/docs/\">S1</a>). Google makes it, an <a href=\"/glossary/agent/\">agent</a> that &quot;runs in a virtual machine where it clones your code, installs dependencies, and modifies files&quot; (<a href=\"https://jules.google/docs/\">S1</a>). Its tasks start from the web app, the Jules Tools CLI, the REST API, in alpha, or a GitHub issue labelled &quot;jules&quot; (<a href=\"https://jules.google/docs/\">S1</a>, <a href=\"https://jules.google/docs/running-tasks/\">S4</a>, <a href=\"https://jules.google/docs/api/reference/\">S7</a>, <a href=\"https://jules.google/docs/cli/reference\">S9</a>). The pages read state no licence: it has a free plan, with Jules in Pro and Jules in Ultra included in the Google AI Pro and Ultra plans (<a href=\"https://jules.google/docs/usage-limits/\">S6</a>). It is winding down: read-only after 11 November 2026, and &quot;Jules will wind down on December 31, 2026&quot; (<a href=\"https://jules.google/docs/changelog/\">S2</a>). Google publishes no version numbers for the agent; the latest changelog entry seen is the turndown notice of 29 October 2026 (<a href=\"https://jules.google/docs/changelog/\">S2</a>).",
      "instanceOf": [
        {
          "id": "industry.agent",
          "label": "Agent",
          "url": "/glossary/agent/"
        }
      ],
      "conformsTo": [],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "Google's Gemini only: Gemini 3 Flash the base model for all tiers since 30 January 2026, Gemini 3.1 Pro the default for Pro users since 9 March 2026",
          "sources": [
            {
              "id": "S2",
              "titleHtml": "Google, Jules changelog",
              "read": "2026-11-22",
