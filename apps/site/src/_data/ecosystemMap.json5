    {
      "id": "product.gemini-cli",
      "slug": "gemini-cli",
      "name": "Gemini CLI",
      "title": "Gemini CLI (Google)",
      "vendor": "Google",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.gemini-cli.md",
      "summaryHtml": "Gemini CLI lets a developer use Gemini &quot;to understand code, automate tasks, and build workflows with your local project context&quot;: &quot;an open-source AI agent that brings the power of Gemini directly into your terminal&quot; (<a href=\"https://geminicli.com/docs/\">S1</a>, <a href=\"https://github.com/google-gemini/gemini-cli\">S2</a>). Google makes it, as <code>google-gemini/gemini-cli</code>, under the Apache License 2.0 (<a href=\"https://github.com/google-gemini/gemini-cli\">S2</a>). It runs as a terminal CLI, headless for scripts, with a VS Code companion and in JetBrains and Zed through ACP (<a href=\"https://geminicli.com/docs/\">S1</a>, <a href=\"https://geminicli.com/docs/ide-integration/\">S9</a>). Since 18 June 2026 it serves only organisations with Gemini Code Assist Standard or Enterprise licences or paid API keys; free, Google AI Pro and Ultra users moved to the Antigravity CLI (<a href=\"https://github.com/google-gemini/gemini-cli\">S2</a>, <a href=\"https://developers.googleblog.com/an-important-update-transitioning-gemini-cli-to-antigravity-cli/\">S12</a>). The latest stable release seen is 0.70.0, of 19 November 2026 (<a href=\"https://github.com/google-gemini/gemini-cli/releases\">S3</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a <a href=\"/glossary/client/\">client</a>. Its skills follow the <a href=\"/specifications/#spec-agent-skills\">Agent Skills specification</a>. Its maker's own words for it are on the vendor card <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/vendors/google/google.gemini.md\">Gemini (Google)</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
