          "label": "Agent Skills specification",
          "url": "/specifications/#spec-agent-skills"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "OpenAI, Anthropic, Google and Microsoft models through Copilot, by <code>/model</code> or <code>--model</code>; or &quot;an OpenAI-compatible endpoint, Azure OpenAI, or Anthropic, including locally running models such as Ollama&quot;; Microsoft 365 Copilot models in public preview",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "GitHub Docs, About GitHub Copilot CLI",
              "read": "2026-11-22",
              "url": "https://docs.github.com/en/copilot/concepts/agents/about-copilot-cli"
            },
            {
              "id": "S12",
