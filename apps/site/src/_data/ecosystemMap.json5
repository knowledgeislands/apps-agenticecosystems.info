    {
      "id": "product.github-copilot-cli",
      "slug": "github-copilot-cli",
      "name": "GitHub Copilot CLI",
      "title": "GitHub Copilot CLI (GitHub)",
      "vendor": "GitHub",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.github-copilot-cli.md",
      "summaryHtml": "Copilot CLI lets a developer &quot;use Copilot directly from your terminal&quot;, giving &quot;quick access to a powerful AI agent, without having to leave your terminal&quot;, interactively or programmatically (<a href=\"https://docs.github.com/en/copilot/concepts/agents/about-copilot-cli\">S1</a>). GitHub makes it, as <code>github/copilot-cli</code>, which &quot;brings the power of Copilot coding agent directly to your terminal&quot; (<a href=\"https://github.com/github/copilot-cli\">S2</a>). It runs on Linux, macOS and Windows, can be followed and steered &quot;from any Copilot client&quot;, and works as an agent inside editors over ACP in public preview (<a href=\"https://docs.github.com/en/copilot/concepts/agents/about-copilot-cli\">S1</a>, <a href=\"https://docs.github.com/en/copilot/reference/copilot-cli-reference/acp-server\">S8</a>). It is proprietary, under the &quot;GitHub Copilot CLI License&quot;, and needs &quot;an active Copilot subscription&quot; (<a href=\"https://github.com/github/copilot-cli/blob/main/LICENSE.md\">S5</a>, <a href=\"https://github.com/github/copilot-cli\">S2</a>). It became generally available on 25 February 2026 (<a href=\"https://github.blog/changelog/2026-02-25-github-copilot-cli-is-now-generally-available/\">S14</a>). The latest stable release seen is 1.0.114, of 18 November 2026 (<a href=\"https://github.com/github/copilot-cli/releases/tag/v1.0.114\">S4</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a <a href=\"/glossary/client/\">client</a>. Its skills follow the <a href=\"/specifications/#spec-agent-skills\">Agent Skills specification</a>. Its maker's own words for it are on the vendor card <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/vendors/microsoft/microsoft.copilot.md\">Copilot (Microsoft)</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
          "url": "/specifications/#spec-mcp"
        },
        {
