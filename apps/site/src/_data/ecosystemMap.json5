    {
      "id": "product.deepseek-harness",
      "slug": "deepseek-harness",
      "name": "DeepSeek Harness",
      "title": "DeepSeek Harness (DeepSeek)",
      "vendor": "DeepSeek",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.deepseek-harness.md",
      "summaryHtml": "DeepSeek Harness lets developers run an agent that can &quot;read and edit workspace files, run commands, delegate work, and maintain a plan&quot;, on a harness where &quot;every part of the product is a plugin, including the model adapter, the tool registry, the session log&quot; (<a href=\"https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/user/guide/index.md\">S8</a>, <a href=\"https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/architecture.md\">S7</a>). DeepSeek makes it: &quot;DeepSeek Harness (<code>dsh</code>) is an open-source agent harness developed by DeepSeek AI&quot;, &quot;built on an everything-is-a-plugin architecture and powered by Cordis&quot;, in the <code>deepseek-ai</code> GitHub organisation (<a href=\"https://github.com/deepseek-ai/deepseek-harness\">S1</a>). It runs as a web UI started by <code>npx @deepseek-ai/dsh web</code>, a desktop app, and headless, SDK, ACP and terminal profiles of the <code>dsh</code> command (<a href=\"https://github.com/deepseek-ai/deepseek-harness\">S1</a>, <a href=\"https://github.com/deepseek-ai/deepseek-harness/blob/master/apps/cli/README.md\">S6</a>, <a href=\"https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/architecture.md\">S7</a>). It is MIT licensed (<a href=\"https://github.com/deepseek-ai/deepseek-harness\">S1</a>). It is &quot;in developer preview and iterating rapidly. THERE WILL BE COMPATIBILITY-BREAKING CHANGES&quot;, and DeepSeek's API documentation says it &quot;is now in developer preview for agent harness developers worldwide&quot; (<a href=\"https://github.com/deepseek-ai/deepseek-harness\">S1</a>, <a href=\"https://api-docs.deepseek.com/\">S3</a>); every capability below is therefore <code>partial</code> at most. The newest release seen is the prerelease 0.2.3-alpha.1, of 22 November 2026, under npm's <code>alpha</code> tag; 0.2.2-rc.5, of 18 November 2026, remains npm's <code>latest</code> (<a href=\"https://github.com/deepseek-ai/deepseek-harness/releases\">S2</a>, <a href=\"https://registry.npmjs.org/@deepseek-ai/dsh\">S24</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a <a href=\"/glossary/client/\">client</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "partial",
          "detailHtml": "Developer preview. DeepSeek built in, its list from the DeepSeek API; bundled providers &quot;such as <code>anthropic</code>, <code>openai</code>, <code>moonshotai</code> for Kimi, or <code>zai</code> for GLM&quot;; a custom model API &quot;for a relay, a company gateway, a self-hosted server&quot;; local runners such as Ollama not named",
          "sources": [
            {
              "id": "S5",
              "titleHtml": "DeepSeek, Configure models",
              "read": "2026-11-22",
              "url": "https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/user/guide/providers.md"
            },
            {
              "id": "S3",
              "titleHtml": "DeepSeek, DeepSeek API Docs: Your First API Call",
              "read": "2026-11-22",
              "url": "https://api-docs.deepseek.com/"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "partial",
          "detailHtml": "Developer preview. The session log is an &quot;append-only <code>SessionEvent</code> log&quot;; <code>dsh --profile tui --resume &lt;id&gt;</code>; headless runs &quot;one fresh persisted session&quot;; ACP lists, resumes and closes sessions across restarts",
          "sources": [
            {
              "id": "S7",
              "titleHtml": "DeepSeek, Architecture",
              "read": "2026-11-22",
              "url": "https://github.com/deepseek-ai/deepseek-harness/blob/master/docs/architecture.md"
            },
            {
              "id": "S6",
              "titleHtml": "DeepSeek, dsh CLI README",
              "read": "2026-11-22",
              "url": "https://github.com/deepseek-ai/deepseek-harness/blob/master/apps/cli/README.md"
            },
            {
              "id": "S20",
              "titleHtml": "DeepSeek, dsh-acp README",
              "read": "2026-11-22",
              "url": "https://github.com/deepseek-ai/deepseek-harness/blob/master/packages/acp/acp/README.md"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "partial",
          "detailHtml": "Developer preview. The <code>subagent</code> tool delegates to named providers; &quot;Local spawn and fork children retain durable sessions&quot;",
          "sources": [
            {
              "id": "S9",
              "titleHtml": "DeepSeek, dsh-subagent README",
              "read": "2026-11-22",
              "url": "https://github.com/deepseek-ai/deepseek-harness/blob/master/packages/subagent/subagent/README.md"
            }
          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "partial",
          "detailHtml": "Developer preview, off by default: <strong>Use Agent Teams</strong> adds &quot;durable shared task board&quot;; &quot;Members use standard subagent tools&quot; to &quot;discover and contact one another&quot; and &quot;share one checkout&quot;",
          "sources": [
            {
              "id": "S13",
              "titleHtml": "DeepSeek, dsh-agent-team README",
              "read": "2026-11-22",
              "url": "https://github.com/deepseek-ai/deepseek-harness/blob/master/packages/team/agent-team/README.md"
            },
            {
              "id": "S14",
              "titleHtml": "DeepSeek, dsh-tool-subagent-control README",
              "read": "2026-11-22",
              "url": "https://github.com/deepseek-ai/deepseek-harness/blob/master/packages/subagent/tool-subagent-control/README.md"
            }
          ]
        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "partial",
          "detailHtml": "Developer preview. Skills as <code>&lt;name&gt;/SKILL.md</code> or flat <code>&lt;name&gt;.md</code> with <code>name</code> and <code>description</code> front matter, from project, custom and user roots, loaded on demand; the pages read do not name the specification",
          "sources": [
