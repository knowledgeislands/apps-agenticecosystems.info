    {
      "id": "product.openai-agents-sdk",
      "slug": "openai-agents-sdk",
      "name": "OpenAI Agents SDK",
      "title": "OpenAI Agents SDK (OpenAI)",
      "vendor": "OpenAI",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.openai-agents-sdk.md",
      "summaryHtml": "The OpenAI Agents SDK lets a developer &quot;build agentic AI apps in a lightweight, easy-to-use package with very few abstractions&quot; (<a href=\"https://openai.github.io/openai-agents-python/\">S1</a>). OpenAI makes it, as &quot;a production-ready upgrade of our previous experimentation for agents, Swarm&quot; (<a href=\"https://openai.github.io/openai-agents-python/\">S1</a>): a Python library, &quot;a lightweight, powerful framework for multi-agent workflows&quot;, and a TypeScript one &quot;for multi-agent workflows and voice agents&quot; (<a href=\"https://github.com/openai/openai-agents-python\">S2</a>, <a href=\"https://github.com/openai/openai-agents-js\">S15</a>). It has no surface of its own: &quot;The SDK runs inside your application&quot;, whose runner &quot;handles the agent loop and handoffs&quot; (<a href=\"https://developers.openai.com/api/docs/guides/agents\">S17</a>). Both libraries are MIT open source (<a href=\"https://github.com/openai/openai-agents-python\">S2</a>, <a href=\"https://github.com/openai/openai-agents-js\">S15</a>), on a <code>0.Y.Z</code> scheme because the SDK &quot;is still evolving rapidly&quot; (<a href=\"https://openai.github.io/openai-agents-python/release/\">S20</a>). The latest Python release seen is v0.25.0, of 17 November 2026, with the pre-release v1.0.0-alpha.1 of 20 November (<a href=\"https://github.com/openai/openai-agents-python/releases\">S3</a>, <a href=\"https://github.com/openai/openai-agents-python/releases/tag/v0.25.0\">S4</a>, <a href=\"https://github.com/openai/openai-agents-python/releases/tag/v1.0.0-alpha.1\">S5</a>); the latest TypeScript release is <code>@openai/agents</code> 0.22.0, of 12 November (<a href=\"https://github.com/openai/openai-agents-js/releases\">S16</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a>. Its maker's own words for it are on the vendor card <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/vendors/openai/openai.harness.md\">Harness (OpenAI)</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
          "url": "/specifications/#spec-mcp"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "OpenAI models through the Responses API by default, <code>gpt-5.6-luna</code> unless set; any OpenAI-compatible endpoint or a custom <code>ModelProvider</code>, mixed per agent; Any-LLM and LiteLLM as &quot;best-effort, beta adapter integrations&quot;; local models not mentioned",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "OpenAI, OpenAI Agents SDK (Python docs introduction)",
              "read": "2026-11-22",
              "url": "https://openai.github.io/openai-agents-python/"
            },
            {
              "id": "S2",
              "titleHtml": "OpenAI, openai/openai-agents-python repository",
              "read": "2026-11-22",
              "url": "https://github.com/openai/openai-agents-python"
            },
            {
              "id": "S6",
              "titleHtml": "OpenAI, Agents SDK: Models",
              "read": "2026-11-22",
              "url": "https://openai.github.io/openai-agents-python/models/"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "&quot;Built-in session memory to automatically maintain conversation history across multiple agent runs&quot;, in SQLite, Redis, SQLAlchemy, MongoDB, Dapr or OpenAI Conversations; a paused run resumes from &quot;the same session ID and the same underlying storage backend&quot;",
          "sources": [
            {
              "id": "S7",
              "titleHtml": "OpenAI, Agents SDK: Sessions",
              "read": "2026-11-22",
              "url": "https://openai.github.io/openai-agents-python/sessions/"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "yes",
          "detailHtml": "Agents as tools: &quot;A manager agent keeps control of the conversation and calls specialist agents through <code>Agent.as_tool()</code>&quot;; handoffs instead pass the turn to a specialist",
          "sources": [
            {
              "id": "S8",
              "titleHtml": "OpenAI, Agents SDK: Agent orchestration",
              "read": "2026-11-22",
              "url": "https://openai.github.io/openai-agents-python/multi_agent/"
            }
          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "unknown",
          "detailHtml": "The orchestration page describes handoffs, agents as tools, chaining and parallel runs, no agents messaging each other",
          "sources": [
            {
              "id": "S8",
              "titleHtml": "OpenAI, Agents SDK: Agent orchestration",
              "read": "2026-11-22",
              "url": "https://openai.github.io/openai-agents-python/multi_agent/"
            }
          ]
        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "yes",
          "detailHtml": "Sandbox agents' Skills capability mounts <code>SKILL.md</code> folders into &quot;a Codex auto-discovery root&quot;, <code>.agents</code> by default, eagerly or lazily through <code>load_skill</code>; the pages read do not name the specification",
          "sources": [
            {
              "id": "S10",
              "titleHtml": "OpenAI, Agents SDK: Sandbox agents",
