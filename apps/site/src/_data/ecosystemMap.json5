              "read": "2026-11-22",
              "url": "https://docs.github.com/en/copilot/reference/ai-models/supported-models"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "<code>--resume</code> or <code>/resume</code> to &quot;select and resume an interactive CLI session&quot;, <code>copilot --continue</code> for the last one; cloud sessions brought to the local environment",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "GitHub Docs, Using GitHub Copilot CLI",
              "read": "2026-11-22",
              "url": "https://docs.github.com/en/copilot/how-tos/copilot-cli/use-copilot-cli/overview"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "yes",
          "detailHtml": "Built-in Explore, Task, General purpose, Code review, Research and Rubber duck agents; &quot;Multiple agents can run in parallel&quot;; with <code>/fleet</code> the main agent acts &quot;as orchestrator&quot; and &quot;Each subagent has its own context window&quot;",
