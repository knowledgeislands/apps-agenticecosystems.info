            }
          ]
        },
        {
          "id": "industry.channel",
          "slug": "channel",
          "value": "yes",
          "detailHtml": "The messaging gateway brings chats from many platforms into its sessions; webhooks &quot;trigger Hermes agent runs&quot;, and <code>mirror_to_session</code> appends a delivery to a chat's session; inbound A2A tasks are &quot;injected into a live gateway session&quot;",
          "sources": [
            {
              "id": "S15",
              "titleHtml": "Nous Research, Hermes Agent docs: Messaging Gateway",
