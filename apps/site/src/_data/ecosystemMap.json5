    {
      "id": "product.opencode",
      "slug": "opencode",
      "name": "OpenCode",
      "title": "OpenCode (Anomaly)",
      "vendor": "Anomaly",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.opencode.md",
      "summaryHtml": "OpenCode is &quot;the open source coding agent&quot;, offered as &quot;a terminal-based interface, desktop app, or web app&quot; (<a href=\"https://opencode.ai\">S1</a>, <a href=\"https://opencode.ai/docs\">S2</a>). Anomaly makes it, &quot;built in the open by Anomaly&quot; with over a thousand contributors, in the <code>anomalyco</code> GitHub organisation (<a href=\"https://opencode.ai\">S1</a>, <a href=\"https://github.com/anomalyco/opencode\">S3</a>). It runs as a terminal interface and CLI, a desktop app in beta, a web interface from a local server and a new mobile app (<a href=\"https://opencode.ai\">S1</a>, <a href=\"https://opencode.ai/docs\">S2</a>, <a href=\"https://github.com/anomalyco/opencode\">S3</a>, <a href=\"https://opencode.ai/docs/cli/web/\">S13</a>). It is MIT open source, with free models, a $10-a-month OpenCode Go plan and paid inference for teams (<a href=\"https://opencode.ai\">S1</a>, <a href=\"https://opencode.ai/docs\">S2</a>). The latest release seen is v2.3.2, of 18 November 2026 (<a href=\"https://opencode.ai/changelog\">S4</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a <a href=\"/glossary/client/\">client</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
          "url": "/specifications/#spec-mcp"
        },
        {
          "id": "spec.acp",
          "label": "Agent Client Protocol (ACP)",
          "url": "/specifications/#spec-acp"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "Many providers from the models.dev catalogue, &quot;200+ providers, including local models&quot; such as Ollama, LM Studio and vLLM; ChatGPT and GitHub Copilot sign-in",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "Anomaly, OpenCode home",
              "read": "2026-11-22",
              "url": "https://opencode.ai"
            },
            {
              "id": "S12",
              "titleHtml": "Anomaly, Providers",
              "read": "2026-11-22",
              "url": "https://opencode.ai/docs/providers/"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "<code>/sessions</code> returns to an earlier session; the server API lists, forks and archives sessions",
          "sources": [
            {
              "id": "S14",
              "titleHtml": "Anomaly, CLI: TUI",
              "read": "2026-11-22",
              "url": "https://opencode.ai/docs/cli/tui/"
