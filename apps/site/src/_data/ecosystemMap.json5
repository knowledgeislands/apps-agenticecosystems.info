    {
      "id": "product.delta",
      "slug": "delta",
      "name": "Delta",
      "title": "Delta (Zed Industries)",
      "vendor": "Zed Industries",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.delta.md",
      "summaryHtml": "Delta lets a team code with agents together and review what they build, keeping each conversation joined to the code it changed: &quot;a multiplayer environment for coding with agents and reviewing what they build&quot;, in which &quot;an agent works in a checkout of your repository, and you review and pull in the results&quot; (<a href=\"https://zed.dev/blog/introducing-delta\">S2</a>, <a href=\"https://delta.dev/docs/getting-started\">S5</a>). Zed Industries makes it, &quot;From the creators of Zed&quot;, on DeltaDB, which &quot;replicates the conversation and the worktree together, in real time, for everyone in a thread&quot; (<a href=\"https://delta.dev/\">S1</a>, <a href=\"https://zed.dev/blog/introducing-delta\">S2</a>). It runs as a desktop app for macOS, Linux and Windows, as Delta Web in a browser, which can be added to a phone's Home Screen, and through the Delta CLI, in beta (<a href=\"https://delta.dev/docs/installation\">S6</a>, <a href=\"https://delta.dev/docs/collaboration/delta-on-the-web\">S16</a>, <a href=\"https://delta.dev/docs/cli/get-started\">S17</a>). Delta is in public beta; it shares Zed's account and plans, Personal at $0 and Pro at $10 a month, with Cloud Runners free for now (<a href=\"https://zed.dev/blog/delta-public-beta\">S3</a>, <a href=\"https://delta.dev/pricing\">S21</a>). No page read names a licence or calls Delta open source: it is offered under Zed Industries' Delta Product Terms and General Terms, though its Claude Code plugin &quot;is open source&quot; (<a href=\"https://delta.dev/terms\">S22</a>, <a href=\"https://delta.dev/cli\">S20</a>). The latest release seen is 0.28.4, of 20 November 2026 (<a href=\"https://delta.dev/docs/whats-in-the-latest\">S4</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a>, an <a href=\"/glossary/agent-host/\">agent host</a> for its threads and a <a href=\"/glossary/client/\">client</a> onto them.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.agent-host",
          "label": "Agent host",
          "url": "/glossary/agent-host/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
