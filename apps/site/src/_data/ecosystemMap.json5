            }
          ]
        },
        {
          "id": "industry.instruction-file",
          "slug": "instruction-file",
          "value": "unknown",
          "detailHtml": "Agents and sandbox agents take <code>instructions</code> in code; no instruction file such as <code>AGENTS.md</code> is named",
          "sources": [
            {
              "id": "S1",
