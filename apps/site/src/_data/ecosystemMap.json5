            },
            {
              "id": "S19",
              "titleHtml": "Paperclip Labs, Paperclip docs: Deployment modes",
              "read": "2026-11-22",
              "url": "https://docs.paperclip.ing/reference/deploy/deployment-modes/"
            }
          ]
        },
        {
          "id": "industry.agent-host",
          "slug": "agent-host",
          "value": "yes",
          "detailHtml": "Adapters &quot;Launch or call the underlying runtime&quot; and &quot;Capture results, session state, and usage metadata&quot; for Claude Code, Codex, Gemini, Cursor, OpenCode, Pi, Hermes and others; the experimental Runner keeps &quot;the provider process and session alive between runs&quot;",
          "sources": [
            {
              "id": "S5",
              "titleHtml": "Paperclip Labs, Paperclip docs: Adapters overview",
              "read": "2026-11-22",
              "url": "https://docs.paperclip.ing/reference/adapters/overview/"
            },
            {
              "id": "S16",
              "titleHtml": "Paperclip Labs, Paperclip docs: Paperclip Runner",
              "read": "2026-11-22",
              "url": "https://docs.paperclip.ing/reference/adapters/paperclip-runner/"
            }
          ]
        },
        {
          "id": "industry.channel",
          "slug": "channel",
          "value": "partial",
          "detailHtml": "Experimental chat connectors for Slack, Discord, Teams and Telegram, where &quot;eligible messages can start or continue agent tasks&quot;; signed webhook triggers start routines",
          "sources": [
            {
              "id": "S8",
              "titleHtml": "Paperclip Labs, Paperclip docs: Connectors",
              "read": "2026-11-22",
              "url": "https://docs.paperclip.ing/connectors/"
            },
            {
              "id": "S11",
              "titleHtml": "Paperclip Labs, Paperclip docs: Experimental features",
              "read": "2026-11-22",
