          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "unknown",
          "detailHtml": "Only a fix for &quot;SuperGrok Heavy responses losing the lead answer when other agents chimed in&quot;",
          "sources": [
