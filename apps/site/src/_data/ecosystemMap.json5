    {
      "id": "product.microsoft-365-copilot",
      "slug": "microsoft-365-copilot",
      "name": "Microsoft 365 Copilot",
      "title": "Microsoft 365 Copilot (Microsoft)",
      "vendor": "Microsoft",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.microsoft-365-copilot.md",
      "summaryHtml": "Microsoft 365 Copilot lets people at work draft, analyse and get work done across Microsoft 365 with AI grounded &quot;in web and/or organizational data&quot;, and through Cowork it &quot;carries out tasks across your Microsoft 365 environment&quot; on their behalf (<a href=\"https://learn.microsoft.com/en-us/copilot/microsoft-365/microsoft-365-copilot-overview\">S1</a>, <a href=\"https://learn.microsoft.com/en-us/microsoft-365/copilot/cowork/\">S2</a>). Microsoft makes it; its app &quot;is now called Microsoft Copilot&quot;, while the licences keep the Microsoft 365 Copilot name (<a href=\"https://learn.microsoft.com/en-us/copilot/microsoft-365/microsoft-365-copilot-overview\">S1</a>). It runs at <code>copilot.cloud.microsoft</code>, in the Microsoft Copilot app for web, desktop and mobile, and inside Word, Excel, PowerPoint, OneNote, Outlook and Teams (<a href=\"https://learn.microsoft.com/en-us/copilot/microsoft-365/microsoft-365-copilot-overview\">S1</a>). It is sold as per-user licences, Copilot Chat (Basic), Microsoft 365 Copilot (Basic) and the Microsoft 365 Copilot (Premium) add-on, with Cowork, Copilot Code and Autopilot billed by usage (<a href=\"https://learn.microsoft.com/en-us/copilot/microsoft-365/microsoft-365-copilot-overview\">S1</a>). Microsoft publishes no version numbers; the latest release notes seen are of 17 November 2026 (<a href=\"https://learn.microsoft.com/en-us/copilot/microsoft-365/release-notes\">S8</a>). It is an <a href=\"/glossary/agent/\">agent</a> and a <a href=\"/glossary/client/\">client</a>. Its skills follow the <a href=\"/specifications/#spec-agent-skills\">Agent Skills specification</a>.",
      "instanceOf": [
        {
          "id": "industry.agent",
          "label": "Agent",
          "url": "/glossary/agent/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
          "url": "/specifications/#spec-mcp"
        },
        {
          "id": "spec.agent-skills",
          "label": "Agent Skills specification",
          "url": "/specifications/#spec-agent-skills"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "&quot;By default, Copilot uses a real-time router&quot;, with a model selector; Cowork offers &quot;GPT 5.6 and GPT 6 variants, Claude Opus, Claude Sonnet, Claude Fable, and Grok 4.7&quot;, Anthropic as a subprocessor; own keys and local models not mentioned",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "Microsoft Learn, What is Microsoft Copilot?",
              "read": "2026-11-22",
              "url": "https://learn.microsoft.com/en-us/copilot/microsoft-365/microsoft-365-copilot-overview"
            },
            {
              "id": "S4",
              "titleHtml": "Microsoft Learn, Copilot Cowork common questions",
              "read": "2026-11-22",
              "url": "https://learn.microsoft.com/en-us/copilot/cowork/cowork-faq"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "Cowork lists recent tasks &quot;so you can resume a previous session&quot;, and previous chats and tasks can be referenced as context; Autopilot's workspace &quot;can retain working context between sessions&quot;",
          "sources": [
            {
              "id": "S3",
              "titleHtml": "Microsoft Learn, Use Copilot Cowork",
              "read": "2026-11-22",
              "url": "https://learn.microsoft.com/en-us/copilot/cowork/use-cowork"
            },
            {
              "id": "S5",
              "titleHtml": "Microsoft Learn, Autopilot (Frontier) overview",
              "read": "2026-11-22",
              "url": "https://learn.microsoft.com/en-us/copilot/autopilot/overview"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "unknown",
          "detailHtml": "Not described; declarative agent manifest 1.8 adds a &quot;worker agent object&quot;, not explained on the pages read",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "Microsoft Learn, What's new for Microsoft 365 Copilot developers",
              "read": "2026-11-22",
              "url": "https://learn.microsoft.com/en-us/microsoft-365/copilot/extensibility/whats-new"
            }
          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "unknown",
          "detailHtml": "Not found",
          "sources": []
        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "yes",
          "detailHtml": "Cowork custom skills are <code>SKILL.md</code> folders in OneDrive <code>/Documents/Cowork/skills/</code>; manifest 1.9's <code>agent_skills</code> &quot;references skill directories that follow the Agent Skills standard&quot;; skills in Copilot Chat generally available",
          "sources": [
            {
              "id": "S3",
              "titleHtml": "Microsoft Learn, Use Copilot Cowork",
              "read": "2026-11-22",
              "url": "https://learn.microsoft.com/en-us/copilot/cowork/use-cowork"
            },
            {
              "id": "S6",
              "titleHtml": "Microsoft Learn, What's new for Microsoft 365 Copilot developers",
              "read": "2026-11-22",
              "url": "https://learn.microsoft.com/en-us/microsoft-365/copilot/extensibility/whats-new"
            }
          ]
        },
        {
          "id": "industry.instruction-file",
          "slug": "instruction-file",
          "value": "unknown",
          "detailHtml": "No instruction file found; Cowork's custom instructions are entered on its Preferences tab, &quot;up to 20 KB&quot;",
          "sources": [
            {
              "id": "S4",
              "titleHtml": "Microsoft Learn, Copilot Cowork common questions",
              "read": "2026-11-22",
              "url": "https://learn.microsoft.com/en-us/copilot/cowork/cowork-faq"
            }
          ]
        },
        {
          "id": "industry.plugin",
          "slug": "plugin",
          "value": "yes",
          "detailHtml": "&quot;Cowork supports plugins from the Microsoft 365 App Store that add new skills and connectors&quot;; admins can deploy them for everyone",
          "sources": [
            {
              "id": "S2",
              "titleHtml": "Microsoft Learn, Copilot Cowork overview",
              "read": "2026-11-22",
              "url": "https://learn.microsoft.com/en-us/microsoft-365/copilot/cowork/"
            },
            {
              "id": "S4",
              "titleHtml": "Microsoft Learn, Copilot Cowork common questions",
              "read": "2026-11-22",
              "url": "https://learn.microsoft.com/en-us/copilot/cowork/cowork-faq"
            }
          ]
        },
        {
          "id": "spec.mcp",
          "slug": "mcp",
          "value": "yes",
          "detailHtml": "A declarative agent's MCP plugin &quot;connects the agent to a remote MCP server&quot;, with OAuth or Entra SSO; admins can create custom MCP connectors",
          "sources": [
            {
              "id": "S7",
              "titleHtml": "Microsoft Learn, Build a plugin for a declarative agent from an MCP server",
              "read": "2026-11-22",
              "url": "https://learn.microsoft.com/en-us/microsoft-365/copilot/extensibility/build-mcp-plugins"
            },
            {
              "id": "S8",
              "titleHtml": "Microsoft Learn, Microsoft 365 Copilot release notes",
              "read": "2026-11-22",
              "url": "https://learn.microsoft.com/en-us/copilot/microsoft-365/release-notes"
            }
          ]
        },
        {
          "id": "industry.environment",
          "slug": "environment",
          "value": "yes",
          "detailHtml": "<code>vendor-sandbox</code>: &quot;Cowork runs in a secure, isolated environment&quot;; it can also work in the user's local Edge browser; Autopilot has its own cloud &quot;computer, and workspace&quot;, in preview",
          "sources": [
            {
              "id": "S4",
              "titleHtml": "Microsoft Learn, Copilot Cowork common questions",
              "read": "2026-11-22",
              "url": "https://learn.microsoft.com/en-us/copilot/cowork/cowork-faq"
            },
            {
              "id": "S5",
              "titleHtml": "Microsoft Learn, Autopilot (Frontier) overview",
              "read": "2026-11-22",
              "url": "https://learn.microsoft.com/en-us/copilot/autopilot/overview"
            }
          ]
        },
        {
          "id": "industry.client",
          "slug": "client",
          "value": "yes",
          "detailHtml": "Web at <code>copilot.cloud.microsoft</code>, the Microsoft Copilot desktop app for Windows and macOS, the mobile app for iOS and Android, and Microsoft 365 apps; Autopilot also uses a one-on-one Teams chat",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "Microsoft Learn, What is Microsoft Copilot?",
