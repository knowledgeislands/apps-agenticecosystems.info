              "url": "https://hermes-agent.nousresearch.com/docs/user-guide/features/kanban"
            }
          ]
        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "yes",
          "detailHtml": "<code>SKILL.md</code> skills in <code>~/.hermes/skills/</code> and external folders, with progressive disclosure; the maker names the standard: &quot;compatible with the agentskills.io open standard&quot;",
          "sources": [
            {
              "id": "S8",
              "titleHtml": "Nous Research, Hermes Agent docs: Skills System",
              "read": "2026-11-22",
              "url": "https://hermes-agent.nousresearch.com/docs/user-guide/features/skills"
