        {
          "id": "industry.agent-host",
          "slug": "agent-host",
          "value": "partial",
          "detailHtml": "Opt-in only: OpenAI turns can be handed to the Codex CLI app-server, &quot;Hermes becomes the shell around it (sessions DB, slash commands, gateway, memory and skill review)&quot;",
          "sources": [
            {
              "id": "S19",
              "titleHtml": "Nous Research, Hermes Agent docs: Codex App-Server Runtime",
              "read": "2026-11-22",
