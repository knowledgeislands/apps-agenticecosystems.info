    {
      "id": "product.lm-studio-bionic",
      "slug": "lm-studio-bionic",
      "name": "LM Studio Bionic",
      "title": "LM Studio Bionic (Element Labs)",
      "vendor": "Element Labs",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.lm-studio-bionic.md",
      "summaryHtml": "LM Studio Bionic lets people get coding, research and document work done by an agent running open models, locally or in the cloud: &quot;the AI agent designed for open models&quot;, &quot;an excellent agentic harness, especially for coding and working with documents&quot; (<a href=\"https://lmstudio.ai/docs/bionic\">S1</a>). Element Labs, the maker of LM Studio, makes it, and it &quot;is a new, separate app from LM Studio&quot;, which stays for &quot;advanced low-level configuration&quot; (<a href=\"https://lmstudio.ai/docs/bionic\">S1</a>, <a href=\"https://lmstudio.ai/blog/introducing-lm-studio-bionic\">S2</a>). It runs as a desktop app on macOS (Apple silicon), Windows (x64 and Arm64) and Linux (x64 and Arm64, as AppImages) (observed from the download links; no Intel Mac build was served), and its local models are &quot;powered by the LM Studio runtime&quot; (<a href=\"https://lmstudio.ai/blog/introducing-lm-studio-bionic\">S2</a>, <a href=\"https://lmstudio.ai/download/bionic/latest/darwin/arm64\">S12</a>). No licence is stated on the pages read; cloud models need an LM Studio account with billing and credits (<a href=\"https://lmstudio.ai/docs/bionic/models\">S6</a>). The latest release seen is 1.2.2, of 20 November 2026, served as build 1.2.2-3 (<a href=\"https://lmstudio.ai/changelog\">S7</a>, <a href=\"https://lmstudio.ai/download/bionic/latest/darwin/arm64\">S12</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a desktop <a href=\"/glossary/client/\">client</a>. Its skills follow the <a href=\"/specifications/#spec-agent-skills\">Agent Skills specification</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
          "url": "/specifications/#spec-mcp"
        },
        {
          "id": "spec.agent-skills",
          "label": "Agent Skills specification",
          "url": "/specifications/#spec-agent-skills"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "Open models only on the pages read: &quot;Run locally, connect through LM Link, or use the largest frontier open models through LM Studio Secure Cloud&quot;; 1.2.1 adds &quot;Experimental support for external API models&quot;",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "Element Labs, Bionic: models",
              "read": "2026-11-22",
              "url": "https://lmstudio.ai/docs/bionic/models"
            },
            {
              "id": "S8",
              "titleHtml": "Element Labs, Bionic 1.2.1 release notes",
              "read": "2026-11-22",
              "url": "https://lmstudio.ai/changelog/bionic-v1.2.1"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "&quot;A session is a conversation and task thread inside a project&quot;, to pin, rename, archive or delete, with forks; &quot;Faster browsing and search for large session histories&quot; in 1.1.9",
          "sources": [
            {
              "id": "S3",
              "titleHtml": "Element Labs, Bionic: projects and sessions",
              "read": "2026-11-22",
              "url": "https://lmstudio.ai/docs/bionic/projects-and-sessions"
            },
            {
              "id": "S7",
              "titleHtml": "Element Labs, Bionic changelog",
              "read": "2026-11-22",
              "url": "https://lmstudio.ai/changelog"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "yes",
          "detailHtml": "In a code project Bionic &quot;can search the repository and use sub-sessions to investigate in parallel when appropriate&quot;",
          "sources": [
            {
              "id": "S4",
              "titleHtml": "Element Labs, Bionic: code project",
              "read": "2026-11-22",
              "url": "https://lmstudio.ai/docs/bionic/agent/code-project"
            }
          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "unknown",
          "detailHtml": "Not found; parallel sessions are the user's, side by side",
          "sources": [
            {
              "id": "S3",
