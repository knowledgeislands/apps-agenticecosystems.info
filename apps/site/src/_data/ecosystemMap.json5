        },
        {
          "id": "spec.mcp",
          "slug": "mcp",
          "value": "yes",
          "detailHtml": "Hosted MCP tools through the Responses API, and Streamable HTTP, SSE (deprecated) and stdio servers; &quot;MCP v2 Streamable HTTP supports concurrent requests&quot; from v0.25.0",
          "sources": [
            {
              "id": "S9",
              "titleHtml": "OpenAI, Agents SDK: Model context protocol (MCP)",
              "read": "2026-11-22",
              "url": "https://openai.github.io/openai-agents-python/mcp/"
            },
            {
              "id": "S4",
              "titleHtml": "OpenAI, openai-agents-python v0.25.0 release",
              "read": "2026-11-22",
              "url": "https://github.com/openai/openai-agents-python/releases/tag/v0.25.0"
            }
          ]
        },
        {
          "id": "industry.environment",
          "slug": "environment",
          "value": "yes",
          "detailHtml": "Sandbox agents run in &quot;real isolated workspaces&quot;: <code>container</code> through <code>DockerSandboxClient</code>, <code>vendor-sandbox</code> through hosted clients for Blaxel, Cloudflare, Databricks, Daytona, E2B, Modal and Vercel; <code>UnixLocalSandboxClient</code> &quot;adds no OS-level confinement&quot; on Linux, <code>none</code>",
          "sources": [
