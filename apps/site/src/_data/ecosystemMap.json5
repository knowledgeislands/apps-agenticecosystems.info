            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "&quot;Hermes Agent automatically saves every conversation as a session&quot;; <code>hermes --continue</code> and <code>--resume</code> by id or title",
          "sources": [
            {
              "id": "S5",
              "titleHtml": "Nous Research, Hermes Agent docs: Sessions",
              "read": "2026-11-22",
              "url": "https://hermes-agent.nousresearch.com/docs/user-guide/sessions"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "yes",
          "detailHtml": "<code>delegate_task</code> &quot;spawns child AIAgent instances with isolated context&quot;; &quot;only its final summary enters the parent's context&quot;",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "Nous Research, Hermes Agent docs: Subagent Delegation",
              "read": "2026-11-22",
              "url": "https://hermes-agent.nousresearch.com/docs/user-guide/features/delegation"
            }
          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "yes",
          "detailHtml": "Bot Mode: &quot;Bots run routines, share group chats, and message each other&quot;, a room's lead bot can pick who answers; Kanban lets &quot;multiple named agents collaborate&quot; through a shared board",
          "sources": [
            {
              "id": "S7",
              "titleHtml": "Nous Research, Hermes Agent docs: Bot Mode",
              "read": "2026-11-22",
