    {
      "id": "product.devin-desktop",
      "slug": "devin-desktop",
      "name": "Devin Desktop",
      "title": "Devin Desktop (Cognition)",
      "vendor": "Cognition",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.devin-desktop.md",
      "summaryHtml": "Devin Desktop lets developers write code and manage their agents, local and cloud, in one place: &quot;Manage any agent, locally or in the cloud, from one command center&quot; (<a href=\"https://devin.ai/desktop\">S13</a>). It is the editor formerly called Windsurf: &quot;Devin Desktop is the new name for Windsurf. It's the same IDE, same editor, and has the same features&quot;, renamed on 2 June 2026 (<a href=\"https://docs.devin.ai/desktop/devin-desktop-faq\">S1</a>). Cognition makes it, having &quot;signed a definitive agreement to acquire Windsurf, the agentic IDE&quot; on 14 July 2025 (<a href=\"https://cognition.com/blog/windsurf\">S12</a>); windsurf.com now redirects to devin.ai, observed on 22 November 2026 (<a href=\"https://devin.ai/desktop\">S13</a>). It runs as a desktop editor for macOS, Windows and Linux, with the Agent Command Center as its primary view and its own Devin Local agent (<a href=\"https://docs.devin.ai/desktop/devin-desktop-faq\">S1</a>, <a href=\"https://docs.devin.ai/desktop/getting-started\">S2</a>, <a href=\"https://docs.devin.ai/desktop/devin-local/overview\">S5</a>). It is sold on Free, Pro, Max, Teams and Enterprise plans; no open-source licence was seen (<a href=\"https://docs.devin.ai/desktop/acp\">S9</a>, <a href=\"https://docs.devin.ai/desktop/devin\">S10</a>). The latest stable release seen is v3.14.30833, of 20 November 2026 (<a href=\"https://docs.devin.ai/desktop/changelog\">S3</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a>, an <a href=\"/glossary/agent-host/\">agent host</a> and a <a href=\"/glossary/client/\">client</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.agent-host",
          "label": "Agent host",
          "url": "/glossary/agent-host/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
          "url": "/specifications/#spec-mcp"
        },
        {
          "id": "spec.acp",
          "label": "Agent Client Protocol (ACP)",
          "url": "/specifications/#spec-acp"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "&quot;SWE-2, Claude, and GPT&quot;, with Gemini and Fusion pairings of a lead and a sidekick model; GPT usage on a ChatGPT Plus or Pro plan; local models unknown",
          "sources": [
            {
              "id": "S4",
              "titleHtml": "Cognition, AI Models",
              "read": "2026-11-22",
              "url": "https://docs.devin.ai/desktop/models"
            },
            {
              "id": "S3",
              "titleHtml": "Cognition, Devin Desktop changelog",
              "read": "2026-11-22",
              "url": "https://docs.devin.ai/desktop/changelog"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "&quot;Local sessions now run in a background process, so you can close or reopen Devin Desktop or the CLI without stopping a session&quot;",
          "sources": [
            {
              "id": "S3",
              "titleHtml": "Cognition, Devin Desktop changelog",
              "read": "2026-11-22",
