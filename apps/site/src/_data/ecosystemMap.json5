              "read": "2026-11-22",
              "url": "https://opencode.ai/docs/agents"
            }
          ]
        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "yes",
          "detailHtml": "<code>SKILL.md</code> folders in <code>.opencode/skills</code>, <code>.claude/skills</code>, <code>.agents/skills</code> and global folders, loaded by the <code>skill</code> tool; the pages read do not name the specification",
          "sources": [
