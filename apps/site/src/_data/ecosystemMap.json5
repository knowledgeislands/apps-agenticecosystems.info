    {
      "id": "product.claude-managed-agents",
      "slug": "claude-managed-agents",
      "name": "Claude Managed Agents",
      "title": "Claude Managed Agents (Anthropic)",
      "vendor": "Anthropic",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.claude-managed-agents.md",
      "summaryHtml": "Claude Managed Agents lets a developer run Claude as an autonomous agent for long-running and asynchronous work without building an agent loop, tool execution or runtime of their own: it is a &quot;pre-built, configurable agent harness that runs in managed infrastructure&quot; (<a href=\"https://platform.claude.com/docs/en/managed-agents/overview\">S1</a>). Anthropic makes it, and sets it beside the Agent SDK as &quot;a hosted agent harness that runs the agent loop, with sessions in an Anthropic-managed cloud sandbox or a self-hosted sandbox on your own infrastructure&quot;, used &quot;from the SDK for your language, the <code>ant</code> CLI, or the REST API&quot; (<a href=\"https://code.claude.com/docs/en/agent-sdk/overview\">S2</a>). It runs on the Claude API, Claude Platform on AWS and Claude Models on Google Cloud (Anthropic managed), all in beta behind the <code>managed-agents-2026-04-01</code> header (&quot;Managed Agents are in beta on every model&quot;, so its rows are <code>partial</code>), and as self-hosted Claude Managed Agents on the customer's own infrastructure, by request (<a href=\"https://platform.claude.com/docs/en/managed-agents/overview\">S1</a>, <a href=\"https://platform.claude.com/docs/en/managed-agents/self-hosted\">S13</a>). It is a paid service, billed on tokens at model rates and on session runtime at $0.08 a session-hour; no licence is stated on the pages read (<a href=\"https://platform.claude.com/docs/en/about-claude/pricing\">S20</a>). It launched in beta on 8 April 2026, and the latest change seen is the self-hosted service of 12 November 2026; the API carries no product version number (<a href=\"https://platform.claude.com/docs/en/release-notes/overview\">S4</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and the <a href=\"/glossary/agent-host/\">agent host</a> of its sessions: &quot;The Managed Agents service keeps the event history&quot; (<a href=\"https://platform.claude.com/docs/en/managed-agents/overview\">S1</a>). Its maker's own words for it are on the vendor card <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/vendors/anthropic/anthropic.agentic-harness.md\">Agentic harness (Anthropic)</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.agent-host",
          "label": "Agent host",
          "url": "/glossary/agent-host/"
        }
      ],
      "conformsTo": [],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "partial",
          "detailHtml": "Beta. Claude only: &quot;Claude 4.5 and later models are supported&quot;; a self-hosted server can send model calls to Amazon Bedrock, Google Cloud, Microsoft Foundry or &quot;a model gateway that you run&quot;",
          "sources": [
            {
              "id": "S5",
              "titleHtml": "Anthropic, Define your agent",
              "read": "2026-11-22",
              "url": "https://platform.claude.com/docs/en/managed-agents/agent-setup"
            },
            {
              "id": "S14",
              "titleHtml": "Anthropic, Self-hosted: inference provider",
              "read": "2026-11-22",
              "url": "https://platform.claude.com/docs/en/managed-agents/self-hosted/inference-provider"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "partial",
          "detailHtml": "Beta. Sessions &quot;resume cleanly after pauses, and store conversation history, sandbox state, and outputs server-side&quot;; a session &quot;maintains conversation history across multiple interactions&quot; and is archived or deleted through the API",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "Anthropic, Claude Managed Agents overview",
              "read": "2026-11-22",
              "url": "https://platform.claude.com/docs/en/managed-agents/overview"
            },
            {
              "id": "S6",
              "titleHtml": "Anthropic, Start a session",
              "read": "2026-11-22",
              "url": "https://platform.claude.com/docs/en/managed-agents/sessions"
            },
            {
              "id": "S7",
              "titleHtml": "Anthropic, Session operations",
              "read": "2026-11-22",
              "url": "https://platform.claude.com/docs/en/managed-agents/session-operations"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "partial",
          "detailHtml": "Beta. &quot;With subagents, it delegates tasks itself and reads what each subagent reports&quot;, each in its own session thread, one level deep; dynamic workflows run many agents in phases",
          "sources": [
            {
              "id": "S8",
              "titleHtml": "Anthropic, Multiagent orchestration",
              "read": "2026-11-22",
              "url": "https://platform.claude.com/docs/en/managed-agents/multiagent-orchestration"
            },
            {
              "id": "S9",
              "titleHtml": "Anthropic, Session threads",
              "read": "2026-11-22",
              "url": "https://platform.claude.com/docs/en/managed-agents/session-threads"
            }
