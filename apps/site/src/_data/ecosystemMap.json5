        },
        {
          "id": "spec.mcp",
          "slug": "mcp",
          "value": "yes",
          "detailHtml": "Servers over stdio, Streamable HTTP and legacy SSE; &quot;supports OAuth 2.0 authentication for MCP servers&quot;",
          "sources": [
