    {
      "id": "product.claude-code",
      "slug": "claude-code",
      "name": "Claude Code",
      "title": "Claude Code (Anthropic)",
      "vendor": "Anthropic",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.claude-code.md",
      "summaryHtml": "Claude Code lets a developer hand coding work to Claude: it is &quot;an agentic coding tool that reads your codebase, edits files, runs commands, and integrates with your development tools&quot; (<a href=\"https://code.claude.com/docs/en/overview\">S1</a>). Anthropic makes it, and its glossary says &quot;Claude Code is the harness; Claude is the model inside it&quot;, an <a href=\"/glossary/agent-harness/\">agent harness</a> (<a href=\"https://code.claude.com/docs/en/glossary\">S2</a>). It runs as a terminal CLI, in VS Code, Cursor and JetBrains, in the Desktop app's Code tab, on the web and in the iOS and Android apps (<a href=\"https://code.claude.com/docs/en/overview\">S1</a>). It is proprietary, used under Anthropic's consumer or commercial terms with a Claude subscription or a Console account (<a href=\"https://code.claude.com/docs/en/overview\">S1</a>, <a href=\"https://code.claude.com/docs/en/legal-and-compliance\">S12</a>). The latest release seen is 2.1.330, of 20 November 2026 (<a href=\"https://code.claude.com/docs/en/changelog\">S3</a>). It is a <a href=\"/glossary/client/\">client</a>. Its skills follow the <a href=\"/specifications/#spec-agent-skills\">Agent Skills specification</a>. Its maker's own words for it are on the vendor card <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/vendors/anthropic/anthropic.claude-code.md\">Claude Code (Anthropic)</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
          "url": "/specifications/#spec-mcp"
        },
        {
          "id": "spec.agent-skills",
          "label": "Agent Skills specification",
          "url": "/specifications/#spec-agent-skills"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "Claude models only, through the Anthropic API, Amazon Bedrock, Google Cloud, Microsoft Foundry or Claude Platform on AWS; Anthropic &quot;doesn't support routing Claude Code to non-Claude models through any gateway&quot;",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "Anthropic, Claude Code overview",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/overview"
            },
            {
              "id": "S13",
              "titleHtml": "Anthropic, Run Claude Code through a gateway",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/gateways"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "Sessions resume (<code>claude -c</code>, <code>/resume</code>) or fork (<code>--fork-session</code>); transcripts kept in <code>~/.claude/projects/</code>; cloud sessions keep running when the laptop closes",
          "sources": [
            {
              "id": "S2",
              "titleHtml": "Anthropic, Claude Code glossary",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/glossary"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "yes",
          "detailHtml": "Subagents run in their own context window and return a summary; built-in Explore, Plan and general-purpose, custom ones in <code>.claude/agents/</code>; worktree isolation",
          "sources": [
            {
              "id": "S2",
              "titleHtml": "Anthropic, Claude Code glossary",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/glossary"
            },
            {
              "id": "S8",
              "titleHtml": "Anthropic, Create custom subagents",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/sub-agents"
            }
          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "partial",
          "detailHtml": "Agent teams: a team lead, a shared task list and mailbox messaging between teammates; experimental, off by default",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "Anthropic, Orchestrate teams of Claude Code sessions",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/agent-teams"
            }
          ]
        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "yes",
          "detailHtml": "Skills &quot;follow the Agent Skills open standard&quot;, with Claude Code's own extras such as <code>context: fork</code>",
          "sources": [
            {
              "id": "S9",
              "titleHtml": "Anthropic, Extend Claude with skills",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/skills"
            }
          ]
        },
        {
          "id": "industry.instruction-file",
          "slug": "instruction-file",
          "value": "yes",
          "detailHtml": "<code>CLAUDE.md</code> at project, user and managed level; <code>AGENTS.md</code> when there is no <code>CLAUDE.md</code>, from v2.1.277; <code>.claude/rules/</code>; auto memory in <code>MEMORY.md</code>",
          "sources": [
            {
              "id": "S2",
              "titleHtml": "Anthropic, Claude Code glossary",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/glossary"
            }
          ]
        },
        {
          "id": "industry.plugin",
          "slug": "plugin",
          "value": "yes",
          "detailHtml": "Plugins bundle skills, agents, hooks and MCP servers, installed from marketplaces",
          "sources": [
            {
              "id": "S10",
              "titleHtml": "Anthropic, Plugins overview",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/plugins/overview"
            }
          ]
        },
        {
          "id": "spec.mcp",
          "slug": "mcp",
          "value": "yes",
          "detailHtml": "MCP client over HTTP, stdio, WebSocket and the deprecated SSE, at local, project and user scope",
          "sources": [
            {
              "id": "S11",
              "titleHtml": "Anthropic, Connect Claude Code to tools via MCP",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/mcp"
            }
          ]
        },
        {
          "id": "industry.environment",
          "slug": "environment",
          "value": "yes",
          "detailHtml": "<code>harness-sandbox</code>: a Bash sandbox, off by default, Seatbelt on macOS and bubblewrap on Linux and WSL2, not native Windows; worktrees and dev containers; cloud sessions on Anthropic-managed or self-hosted infrastructure",
          "sources": [
            {
              "id": "S7",
              "titleHtml": "Anthropic, Sandboxing",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/sandboxing"
            },
            {
              "id": "S2",
              "titleHtml": "Anthropic, Claude Code glossary",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/glossary"
            }
          ]
        },
        {
          "id": "industry.client",
          "slug": "client",
          "value": "yes",
          "detailHtml": "Terminal, IDE, desktop, web and mobile; Remote Control continues a local session from a phone or browser; agent view (research preview) shows background sessions",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "Anthropic, Claude Code overview",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/overview"
            },
            {
              "id": "S14",
              "titleHtml": "Anthropic, Manage multiple agents with agent view",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/agent-view"
            }
          ]
        },
        {
          "id": "industry.agent-host",
          "slug": "agent-host",
          "value": "unknown",
          "detailHtml": "The docs describe hosting only Claude Code's own sessions, in agent view and its background service",
          "sources": [
            {
              "id": "S14",
              "titleHtml": "Anthropic, Manage multiple agents with agent view",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/agent-view"
            }
          ]
        },
        {
          "id": "industry.channel",
          "slug": "channel",
          "value": "partial",
          "detailHtml": "Channels: MCP servers that push events into a running session and can reply, such as Telegram, Discord, iMessage and webhooks; research preview",
          "sources": [
            {
              "id": "S5",
              "titleHtml": "Anthropic, Push events into a running session with channels",
              "read": "2026-11-22",
              "url": "https://code.claude.com/docs/en/channels"
            }
          ]
        },
        {
          "id": "industry.cross-session-messaging",
          "slug": "cross-session-messaging",
          "value": "yes",
          "detailHtml": "<code>ListAgents</code> and <code>SendMessage</code>, over a local socket on one machine and through Remote Control to other machines and cloud sessions; v2.1.224 or later",
          "sources": [
            {
