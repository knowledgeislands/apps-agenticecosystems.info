    {
      "id": "product.opencode",
      "slug": "opencode",
      "name": "OpenCode",
      "title": "OpenCode (Anomaly)",
      "vendor": "Anomaly",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.opencode.md",
      "summaryHtml": "OpenCode is &quot;the open source coding agent&quot;, offered as &quot;a terminal-based interface, desktop app, or web app&quot; (<a href=\"https://opencode.ai\">S1</a>, <a href=\"https://opencode.ai/docs\">S2</a>). Anomaly makes it, &quot;built in the open by Anomaly&quot; with over a thousand contributors, in the <code>anomalyco</code> GitHub organisation (<a href=\"https://opencode.ai\">S1</a>, <a href=\"https://github.com/anomalyco/opencode\">S3</a>). It runs as a terminal interface and CLI, a desktop app in beta, a web interface from a local server and a new mobile app (<a href=\"https://opencode.ai\">S1</a>, <a href=\"https://opencode.ai/docs\">S2</a>, <a href=\"https://github.com/anomalyco/opencode\">S3</a>, <a href=\"https://opencode.ai/docs/cli/web/\">S13</a>). It is MIT open source, with free models, a $10-a-month OpenCode Go plan and paid inference for teams (<a href=\"https://opencode.ai\">S1</a>, <a href=\"https://opencode.ai/docs\">S2</a>). The latest release seen is v2.3.2, of 18 November 2026 (<a href=\"https://opencode.ai/changelog\">S4</a>). It is an <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/industry/industry.agent-harness.md\">agent harness</a> and a <a href=\"https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/industry/industry.client.md\">client</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/industry/industry.agent-harness.md"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/ec0078018250b2ceb6f114ac0085a38e0f969a7c/skills/keystone/ki-agentic-ecosystems/knowledge/industry/industry.client.md"
        }
      ],
