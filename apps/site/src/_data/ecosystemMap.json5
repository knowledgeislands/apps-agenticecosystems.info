            },
            {
              "id": "S13",
              "titleHtml": "Z.ai, ZCode docs: Bot Channel",
              "read": "2026-11-22",
              "url": "https://zcode.z.ai/en/docs/bot-channel"
            }
          ]
        },
        {
          "id": "industry.agent-host",
          "slug": "agent-host",
          "value": "unknown",
          "detailHtml": "Z.ai's docs cite &quot;multi‑framework compatibility&quot;, but the pages read show ZCode running only its own ZCode Agent",
          "sources": [
