              "titleHtml": "Paperclip Labs, Paperclip docs: Issues API",
              "read": "2026-11-22",
              "url": "https://docs.paperclip.ing/reference/api/issues/"
            }
          ]
        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "yes",
          "detailHtml": "&quot;A skill is a folder containing a <code>SKILL.md</code> file&quot;, from GitHub, skills.sh, local paths or a built-in catalogue, synced into each agent's workspace by its adapter; the pages read do not name the specification",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "Paperclip Labs, Paperclip docs: Skills",
              "read": "2026-11-22",
              "url": "https://docs.paperclip.ing/guides/org/skills/"
            }
          ]
        },
        {
          "id": "industry.instruction-file",
          "slug": "instruction-file",
          "value": "yes",
          "detailHtml": "Each agent's instructions bundle has an entry file, usually <code>AGENTS.md</code>, &quot;the file the adapter feeds to the agent on every run&quot;, beside <code>SOUL.md</code>, <code>HEARTBEAT.md</code> and <code>TOOLS.md</code>",
          "sources": [
            {
              "id": "S15",
              "titleHtml": "Paperclip Labs, Paperclip docs: Agents",
              "read": "2026-11-22",
              "url": "https://docs.paperclip.ing/guides/org/agents/"
            }
          ]
        },
        {
          "id": "industry.plugin",
          "slug": "plugin",
          "value": "partial",
          "detailHtml": "&quot;Plugins are in alpha&quot;: packages from npm, a local path or a bundled list add pages, widgets, scheduled jobs, webhooks and sandbox providers; no marketplace mentioned",
          "sources": [
            {
              "id": "S7",
              "titleHtml": "Paperclip Labs, Paperclip docs: Plugins",
              "read": "2026-11-22",
              "url": "https://docs.paperclip.ing/administration/plugins/"
            }
          ]
        },
        {
          "id": "spec.mcp",
          "slug": "mcp",
          "value": "yes",
          "detailHtml": "Connectors reach outside services &quot;or your own MCP server&quot;, with per-action controls set to &quot;Allowed, Ask first, or Off&quot;; an MCP server can also be added to an agent at adapter level",
          "sources": [
            {
              "id": "S2",
              "titleHtml": "Paperclip Labs, paperclipai/paperclip repository",
              "read": "2026-11-22",
              "url": "https://github.com/paperclipai/paperclip"
            },
            {
              "id": "S8",
              "titleHtml": "Paperclip Labs, Paperclip docs: Connectors",
              "read": "2026-11-22",
              "url": "https://docs.paperclip.ing/connectors/"
            }
          ]
        },
        {
          "id": "industry.environment",
          "slug": "environment",
          "value": "partial",
          "detailHtml": "<code>container</code> and <code>vendor-sandbox</code> through sandbox provider plugins (E2B, Daytona, Modal, Cloudflare, Kubernetes in alpha, boxd microVMs), under the experimental Environments setting; worktree &quot;execution workspaces&quot; otherwise",
          "sources": [
            {
              "id": "S9",
              "titleHtml": "Paperclip Labs, Paperclip docs: Sandbox providers",
              "read": "2026-11-22",
              "url": "https://docs.paperclip.ing/reference/adapters/sandbox-providers/"
            },
            {
