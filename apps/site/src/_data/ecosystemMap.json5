        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "partial",
          "detailHtml": "Beta. <code>SKILL.md</code> skills from capability directories and plugins; hosted sandboxes ship skills for spreadsheets, presentations and Word documents; the pages read do not name the specification",
