    {
      "id": "product.qwen-code",
      "slug": "qwen-code",
      "name": "Qwen Code",
      "title": "Qwen Code (Qwen)",
      "vendor": "Qwen",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.qwen-code.md",
      "summaryHtml": "Qwen Code helps a developer &quot;turn ideas into code faster than ever before&quot;: &quot;Qwen's agentic coding tool&quot;, &quot;the open-source AI coding agent for your terminal, editor, desktop, browser, and chat&quot; (<a href=\"https://github.com/QwenLM/qwen-code\">S1</a>, <a href=\"https://qwenlm.github.io/qwen-code-docs/en/users/overview\">S2</a>). It is &quot;maintained by the Qwen Code team&quot; in the <code>QwenLM</code> GitHub organisation, and was &quot;originally based on Google Gemini CLI v0.8.2&quot; (<a href=\"https://github.com/QwenLM/qwen-code\">S1</a>, <a href=\"https://qwenlm.github.io/qwen-code-docs/en/users/support/tos-privacy/\">S22</a>); its own pages do not name Alibaba, which secondary coverage gives as the maker (<a href=\"https://dev.to/paullovelace/qwen-code-10-is-here-and-its-not-just-a-cli-anymore-4g06\">S25</a>), and Alibaba Cloud's Model Studio documents it for its models (<a href=\"https://www.alibabacloud.com/help/en/model-studio/qwen-code\">S23</a>). It runs as a terminal CLI, headless, a desktop app for macOS, Windows and Linux, a browser Web Shell from <code>qwen serve</code>, in VS Code, Zed and JetBrains, through chat channels, and through TypeScript, Python and Java SDKs (<a href=\"https://github.com/QwenLM/qwen-code\">S1</a>, <a href=\"https://qwenlm.github.io/qwen-code-docs/en/blog/quickstart/web-shell-and-desktop/\">S20</a>). It is Apache-2.0 open source, with copyright lines for Google LLC and Qwen (<a href=\"https://github.com/QwenLM/qwen-code/blob/main/LICENSE\">S5</a>). The latest stable release seen is v0.28.3, of 21 November 2026; a Qwen Code 1.0 Preview pre-release &quot;brings together the agent capabilities of Qoder and Qwen Code&quot; (<a href=\"https://github.com/QwenLM/qwen-code/releases\">S3</a>, <a href=\"https://github.com/QwenLM/qwen-code/releases/tag/v1.0.0-preview\">S4</a>). Qoder, &quot;an agentic coding platform&quot; with desktop, mobile, IDE, JetBrains and CLI products, is the other agentic coding product in that line; its page does not name its maker, and secondary coverage calls it &quot;Alibaba's agent-assisted development tool&quot; (<a href=\"https://qoder.com/\">S24</a>, <a href=\"https://dev.to/paullovelace/qwen-code-10-is-here-and-its-not-just-a-cli-anymore-4g06\">S25</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a <a href=\"/glossary/client/\">client</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
          "url": "/specifications/#spec-mcp"
        },
        {
          "id": "spec.acp",
          "label": "Agent Client Protocol (ACP)",
          "url": "/specifications/#spec-acp"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "&quot;Supports OpenAI, Anthropic, Gemini, and Qwen APIs. Any third-party provider or local model (Ollama / vLLM)&quot;; Qwen account sign-in, default <code>qwen3.5-plus</code>; Alibaba's Coding Plan adds Qwen, GLM, Kimi and MiniMax models; Qwen4-Max integrated",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "Qwen, QwenLM/qwen-code repository README",
              "read": "2026-11-22",
              "url": "https://github.com/QwenLM/qwen-code"
            },
            {
              "id": "S18",
              "titleHtml": "Qwen, Model Providers",
              "read": "2026-11-22",
              "url": "https://qwenlm.github.io/qwen-code-docs/en/users/configuration/model-providers/"
            },
            {
              "id": "S21",
              "titleHtml": "Qwen, Weekly update, 19 November 2026",
              "read": "2026-11-22",
              "url": "https://qwenlm.github.io/qwen-code-docs/en/blog/updates/weekly-update-2026-11-19/"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "&quot;Resume past conversations with <code>/resume</code>, and browse, rename, or archive sessions&quot;; <code>/branch</code> forks a conversation into a new session; <code>qwen sessions list</code>",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "Qwen, QwenLM/qwen-code repository README",
              "read": "2026-11-22",
              "url": "https://github.com/QwenLM/qwen-code"
            },
            {
              "id": "S16",
              "titleHtml": "Qwen, Commands",
              "read": "2026-11-22",
              "url": "https://qwenlm.github.io/qwen-code-docs/en/users/features/commands/"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "yes",
          "detailHtml": "Markdown agents in <code>.qwen/agents/</code> and <code>~/.qwen/agents/</code>; &quot;Top-level regular subagents run in the background by default&quot;; &quot;Fork children cannot spawn any further sub-agent&quot;",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "Qwen, SubAgents",
              "read": "2026-11-22",
              "url": "https://qwenlm.github.io/qwen-code-docs/en/users/features/sub-agents/"
            }
          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "partial",
          "detailHtml": "&quot;The experimental Agent Team runtime&quot;: teammates &quot;share a task list, exchange messages&quot;; a leader assigns up to three workstreams; teammates are in-process, not separate sessions",
          "sources": [
            {
              "id": "S15",
              "titleHtml": "Qwen, Multi-Agent Coordination",
              "read": "2026-11-22",
              "url": "https://qwenlm.github.io/qwen-code-docs/en/users/features/multi-agent-coordination/"
            }
          ]
        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "yes",
          "detailHtml": "<code>SKILL.md</code> folders from <code>.qwen/skills/</code>, <code>.agents/skills/</code>, global folders, extensions and bundled skills; the page does not name the specification",
          "sources": [
            {
              "id": "S7",
              "titleHtml": "Qwen, Agent Skills",
              "read": "2026-11-22",
              "url": "https://qwenlm.github.io/qwen-code-docs/en/users/features/skills/"
            }
          ]
        },
        {
          "id": "industry.instruction-file",
          "slug": "instruction-file",
          "value": "yes",
          "detailHtml": "<code>QWEN.md</code> in <code>~/.qwen/</code> and the project root, <code>.qwen/QWEN.local.md</code>; &quot;If your repository already has an <code>AGENTS.md</code> file for other AI tools, Qwen reads that too&quot;",
          "sources": [
            {
              "id": "S8",
              "titleHtml": "Qwen, Memory",
              "read": "2026-11-22",
              "url": "https://qwenlm.github.io/qwen-code-docs/en/users/features/memory/"
            }
          ]
        },
        {
          "id": "industry.plugin",
          "slug": "plugin",
          "value": "yes",
          "detailHtml": "Extensions &quot;package prompts, MCP servers, subagents, skills and custom commands&quot;, from Git, npm, archives or a marketplace; &quot;Claude plugins are automatically converted&quot;",
          "sources": [
            {
              "id": "S9",
              "titleHtml": "Qwen, Extension introduction",
