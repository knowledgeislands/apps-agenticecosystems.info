    {
      "id": "product.autoclaw",
      "slug": "autoclaw",
      "name": "AutoClaw",
      "title": "AutoClaw (Z.ai)",
      "vendor": "Z.ai",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.autoclaw.md",
      "summaryHtml": "AutoClaw lets people hand everyday office, research, design, coding and legal work to agents on their own computer and direct them from a chat app: &quot;AutoClaw is a general agent developed by Z.ai. It can work across files, browsers, and tools to deliver decision-ready reports, tested software, and ready-to-use designs&quot; (<a href=\"https://autoclaw.z.ai/en/\">S1</a>). Z.ai makes it; the Chinese site's legal owner is Beijing Zhipu Huazhang Technology (北京智谱华章科技股份有限公司), whose Chinese name for it is 澳龙 (<a href=\"https://autoclaw.z.ai/cn/\">S17</a>, <a href=\"https://www.ithome.com/0/927/423.htm\">S16</a>). It is &quot;Z.ai's desktop AI Agent for work&quot;, for macOS (Apple silicon and Intel), Windows 10 and later and Linux (x64 and Arm64), with iOS and Android apps, and its agents are reached from Telegram, WhatsApp, Discord, Slack and Lark (<a href=\"https://autoclaw.z.ai/en/docs/getting-started/what-is-autoclaw/\">S2</a>, <a href=\"https://autoclaw.z.ai/en/docs/getting-started/install/\">S3</a>, <a href=\"https://autoclaw.z.ai/en/\">S1</a>, <a href=\"https://autoclaw.z.ai/en/docs/advanced/remote-control/\">S12</a>). It runs on the OpenClaw kernel, upgraded &quot;to version 6.8&quot; in July 2026 (<a href=\"https://autoclaw.z.ai/en/changelog/\">S15</a>). No licence is stated on the pages read, only &quot;All rights reserved&quot;; it is sold on credits, with tokens offered to new users and the GLM Coding Plan usable in it (<a href=\"https://autoclaw.z.ai/en/\">S1</a>, <a href=\"https://autoclaw.z.ai/en/docs/advanced/models/\">S5</a>). The latest release seen is v2.3.0, of 29 October 2026 (<a href=\"https://autoclaw.z.ai/cn/changelog/\">S14</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a> and a <a href=\"/glossary/client/\">client</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
