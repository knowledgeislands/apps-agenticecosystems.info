        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "partial",
          "detailHtml": "Beta. With <code>multi_agent</code> on, &quot;The harness supplies tools to create, message, wait for, and interrupt subagents&quot;; &quot;Each subagent has its own context&quot;",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "OpenAI, Agents API: multi-agent",
