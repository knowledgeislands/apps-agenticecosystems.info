        {
          "id": "industry.client",
          "slug": "client",
          "value": "yes",
          "detailHtml": "Desktop; terminal TUI and browser interface from the <code>zcode</code> command; phone browser through Remote Control; WeChat and Feishu bots",
          "sources": [
            {
              "id": "S2",
              "titleHtml": "Z.ai, zai-org/ZCode repository and README",
              "read": "2026-11-22",
              "url": "https://github.com/zai-org/ZCode"
            },
            {
              "id": "S12",
              "titleHtml": "Z.ai, ZCode docs: Remote Control",
              "read": "2026-11-22",
