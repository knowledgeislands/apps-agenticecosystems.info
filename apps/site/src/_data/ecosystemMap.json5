    {
      "id": "product.grok",
      "slug": "grok",
      "name": "Grok",
      "title": "Grok (SpaceXSI)",
      "vendor": "SpaceXSI",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.grok.md",
      "summaryHtml": "Grok lets anyone chat with a Grok model to ask, write, create images and video, talk by voice, work on uploaded files and reach their own email, files and calendar through connectors (<a href=\"https://docs.x.ai/grok/overview\">S1</a>). It is &quot;SpaceXSI's assistant, available on the web at grok.com and in the iOS and Android apps&quot;, and the docs set it apart from Grok Build and Grok Bot, which have pages of their own (<a href=\"https://docs.x.ai/grok/overview\">S1</a>, <a href=\"https://docs.x.ai/grok/faq\">S2</a>). The App Store lists X Corp. as its seller, under &quot;© xAI Inc.&quot; (<a href=\"https://apps.apple.com/us/app/grok/id6670324846\">S9</a>). No licence is stated on the pages read; &quot;Grok is free to start&quot;, with paid SuperGrok plans, and newer plans under The X Subscription, sharing one weekly usage pool (<a href=\"https://docs.x.ai/grok/overview\">S1</a>, <a href=\"https://docs.x.ai/grok/faq\">S2</a>, <a href=\"https://docs.x.ai/x-subscription/pricing\">S10</a>). The latest release seen is the iOS app 1.4.65, of 12 November (<a href=\"https://apps.apple.com/us/app/grok/id6670324846\">S9</a>), and the newest release-notes entry is of 3 October 2026 (<a href=\"https://grok.com/release-notes\">S5</a>). It is an <a href=\"/glossary/agent-harness/\">agent harness</a>, Grok's own chat loop, and a <a href=\"/glossary/client/\">client</a>.",
      "instanceOf": [
        {
          "id": "industry.agent-harness",
          "label": "Agent harness",
          "url": "/glossary/agent-harness/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.mcp",
          "label": "Model Context Protocol (MCP)",
          "url": "/specifications/#spec-mcp"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "Grok models only on the pages read: Grok 4.7 &quot;now powers Expert mode on grok.com, and Fast mode for paid subscribers&quot;",
          "sources": [
            {
              "id": "S5",
              "titleHtml": "SpaceXSI, Grok release notes",
              "read": "2026-11-22",
              "url": "https://grok.com/release-notes"
            },
            {
              "id": "S8",
              "titleHtml": "SpaceXSI, Grok 4.7",
              "read": "2026-11-22",
              "url": "https://x.ai/news/grok-4-7"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "&quot;Your conversations, settings, and subscription stay in sync across every platform&quot;; Projects hold conversations, files and instructions to return to",
          "sources": [
            {
              "id": "S1",
              "titleHtml": "SpaceXSI, Welcome to Grok",
              "read": "2026-11-22",
