        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "unknown",
          "detailHtml": "&quot;A lead agent assigns work to specialists&quot; sharing a filesystem; the docs show subagents reporting only to the primary thread, not to each other",
          "sources": [
            {
              "id": "S3",
              "titleHtml": "Anthropic, Claude Managed Agents product page",
              "read": "2026-11-22",
              "url": "https://claude.com/platform/claude-managed-agents"
            },
            {
