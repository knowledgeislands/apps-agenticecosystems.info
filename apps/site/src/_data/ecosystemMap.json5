          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "&quot;Use any model you want — Nous Portal, OpenRouter, OpenAI, your own endpoint&quot;, self-hosted Ollama, vLLM and LM Studio, and local models through a managed llama.cpp; &quot;Switch with <code>hermes model</code>&quot;",
          "sources": [
            {
              "id": "S2",
              "titleHtml": "Nous Research, NousResearch/hermes-agent repository README",
              "read": "2026-11-22",
