    {
      "id": "product.gas-city",
      "slug": "gas-city",
      "name": "Gas City",
      "title": "Gas City (Gas City, Inc.)",
      "vendor": "Gas City, Inc.",
      "status": "proposal",
      "reviewed": "2026-11-22",
      "url": "https://github.com/knowledgeislands/ki-agent-backpack/blob/75dd86fbff11a33b551fbd9d37b9d0576b1f9598/skills/keystone/ki-agentic-ecosystems/knowledge/products/product.gas-city.md",
      "summaryHtml": "Gas City lets one person hand a body of work to a fleet of coding agents and have it broken into tasks, run in parallel, gated on review and tracked to completion: it &quot;runs teams of coding agents (Claude Code, Codex, Gemini, and others) on your repositories&quot;, &quot;the open-source platform for building software factories from teams of coding agents&quot; (<a href=\"https://github.com/gastownhall/gascity\">S2</a>). Gas City, Inc. stewards it, in the <code>gastownhall</code> GitHub organisation (<a href=\"https://gascity.com\">S1</a>, <a href=\"https://github.com/gastownhall/gascity\">S2</a>). It is &quot;the platform Gas Town's machinery was extracted into&quot;: Gas Town's roles are now configuration in a pack, &quot;so the same engine runs Gas Town, Ralph, or whatever you configure&quot; (<a href=\"https://docs.gascity.com/getting-started/faq\">S4</a>, <a href=\"https://docs.gascity.com/getting-started/coming-from-gastown\">S6</a>). It runs as the <code>gc</code> CLI on macOS and Linux, installed from Homebrew, with a supervisor that serves a local web dashboard and a REST API (<a href=\"https://github.com/gastownhall/gascity\">S2</a>, <a href=\"https://docs.gascity.com/getting-started/dashboard\">S15</a>, <a href=\"https://docs.gascity.com/guides/connected-clients\">S11</a>). It is MIT open source and free, &quot;the only spend is the model usage of the agents you run&quot;; the maker's commercial Beads Team Server is a separate product (<a href=\"https://docs.gascity.com/getting-started/faq\">S4</a>, <a href=\"https://gascity.com\">S1</a>). The latest release seen is v1.5.1, of 24 October 2026, beside a rolling <code>edge</code> pre-release from <code>main</code> (<a href=\"https://github.com/gastownhall/gascity/releases/tag/v1.5.1\">S16</a>, <a href=\"https://github.com/gastownhall/gascity\">S2</a>). It is an <a href=\"/glossary/agent-host/\">agent host</a> for other makers' harnesses and a <a href=\"/glossary/client/\">client</a> onto their sessions.",
      "instanceOf": [
        {
          "id": "industry.agent-host",
          "label": "Agent host",
          "url": "/glossary/agent-host/"
        },
        {
          "id": "industry.client",
          "label": "Client",
          "url": "/glossary/client/"
        }
      ],
      "conformsTo": [
        {
          "id": "spec.acp",
          "label": "Agent Client Protocol (ACP)",
          "url": "/specifications/#spec-acp"
        }
      ],
      "capabilities": [
        {
          "id": "industry.model",
          "slug": "model",
          "value": "yes",
          "detailHtml": "Whatever harness each agent picks, &quot;Sixteen built-in harnesses, including Claude Code, Codex CLI, Gemini CLI, Cursor Agent, GitHub Copilot, Sourcegraph AMP, OpenCode, Grok, Kimi Code, and Pi&quot;; a per-agent model option and upstreams such as Bedrock, Vertex or an OpenAI-compatible gateway",
          "sources": [
            {
              "id": "S4",
              "titleHtml": "Gas City, Inc., Gas City docs: FAQ",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/getting-started/faq"
            },
            {
              "id": "S7",
              "titleHtml": "Gas City, Inc., Gas City docs: Configuring an Agent",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/guides/configuring-an-agent"
            },
            {
              "id": "S8",
              "titleHtml": "Gas City, Inc., Gas City docs: Harness Recipes",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/guides/harness-recipes"
            }
          ]
        },
        {
          "id": "industry.session",
          "slug": "session",
          "value": "yes",
          "detailHtml": "<code>wake_mode</code> &quot;resume&quot; (default) reuses &quot;provider session key for conversation continuity&quot;; after a restart the orchestrator &quot;adopts the live sessions it finds and resumes from the store&quot;",
          "sources": [
            {
              "id": "S12",
              "titleHtml": "Gas City, Inc., Gas City docs: Config Reference",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/reference/config"
            },
            {
              "id": "S4",
              "titleHtml": "Gas City, Inc., Gas City docs: FAQ",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/getting-started/faq"
            }
          ]
        },
        {
          "id": "industry.subagent",
          "slug": "subagent",
          "value": "unknown",
          "detailHtml": "No agent of its own; its workers are sessions in their own right, and the pages read say nothing of the hosted harnesses' own subagents",
          "sources": [
            {
              "id": "S3",
              "titleHtml": "Gas City, Inc., Gas City docs: How Gas City Works",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/getting-started/how-gas-city-works"
            },
            {
              "id": "S10",
              "titleHtml": "Gas City, Inc., Gas City docs: Tutorial 04, Agent-to-Agent Communication",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/tutorials/04-communication"
            }
          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "yes",
          "detailHtml": "A coordinating agent, such as the Gas Town pack's <code>mayor</code>, slings work to other agents, and agents &quot;coordinate through two indirect channels: mail (messages) and slung work&quot;",
          "sources": [
            {
              "id": "S6",
              "titleHtml": "Gas City, Inc., Gas City docs: Coming from Gas Town",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/getting-started/coming-from-gastown"
            },
            {
              "id": "S10",
              "titleHtml": "Gas City, Inc., Gas City docs: Tutorial 04, Agent-to-Agent Communication",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/tutorials/04-communication"
            }
          ]
        },
        {
          "id": "industry.skill",
          "slug": "skill",
          "value": "yes",
          "detailHtml": "Pack- or role-level skill folders, which &quot;Gas City symlinks … into each agent's provider-specific skill sink&quot;, <code>.claude/skills/</code>, <code>.agents/skills/</code>, <code>.gemini/skills/</code>, <code>.opencode/skills/</code>; the pages read name neither <code>SKILL.md</code> nor the specification",
          "sources": [
            {
              "id": "S5",
              "titleHtml": "Gas City, Inc., Gas City docs: Coming from Coding Agents",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/guides/capabilities-for-coding-agent-users"
            }
          ]
        },
        {
          "id": "industry.instruction-file",
          "slug": "instruction-file",
          "value": "partial",
          "detailHtml": "No loader of its own: each agent's context starts from its role's prompt template; a provider's <code>instructions_file</code> names &quot;the filename the provider reads for project instructions&quot;, <code>AGENTS.md</code> by default",
          "sources": [
            {
              "id": "S5",
              "titleHtml": "Gas City, Inc., Gas City docs: Coming from Coding Agents",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/guides/capabilities-for-coding-agent-users"
            },
            {
              "id": "S12",
              "titleHtml": "Gas City, Inc., Gas City docs: Config Reference",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/reference/config"
            }
          ]
        },
        {
          "id": "industry.plugin",
          "slug": "plugin",
          "value": "yes",
          "detailHtml": "Packs, imported by name and found through a registry, bring &quot;agents, formulas, and orders, along with skills, commands, MCP configuration&quot;; Gas Town's plugins &quot;become orders&quot;",
          "sources": [
            {
              "id": "S13",
              "titleHtml": "Gas City, Inc., Gas City docs: Understanding Packs",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/guides/understanding-packs"
            },
            {
              "id": "S6",
              "titleHtml": "Gas City, Inc., Gas City docs: Coming from Gas Town",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/getting-started/coming-from-gastown"
            }
          ]
        },
        {
          "id": "spec.mcp",
          "slug": "mcp",
          "value": "partial",
          "detailHtml": "The harnesses are the MCP clients; Gas City catalogues packs' MCP configuration, &quot;list-only today (<code>gc mcp list</code> shows what's catalogued; you wire the servers yourself)&quot;, though v1.0.0 added &quot;Provider-native MCP projection for Claude, Codex, and Gemini&quot;",
          "sources": [
            {
              "id": "S5",
              "titleHtml": "Gas City, Inc., Gas City docs: Coming from Coding Agents",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/guides/capabilities-for-coding-agent-users"
            },
            {
              "id": "S18",
              "titleHtml": "Gas City, Inc., gastownhall/gascity CHANGELOG",
              "read": "2026-11-22",
              "url": "https://github.com/gastownhall/gascity/blob/main/CHANGELOG.md"
            }
          ]
        },
        {
          "id": "industry.environment",
          "slug": "environment",
          "value": "yes",
          "detailHtml": "<code>container</code>: the <code>k8s</code> runtime runs &quot;every session in a Kubernetes pod&quot;, and <code>exec:&lt;script&gt;</code> is &quot;how sandbox / micro-VM runtime packs plug in&quot;; locally, tmux is <code>none</code>, its commands &quot;a feature, not a sandbox&quot;",
          "sources": [
            {
              "id": "S7",
              "titleHtml": "Gas City, Inc., Gas City docs: Configuring an Agent",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/guides/configuring-an-agent"
            },
            {
              "id": "S14",
              "titleHtml": "Gas City, Inc., Gas City docs: Command Execution Trust Boundaries",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/reference/trust-boundaries"
            }
          ]
        },
        {
          "id": "industry.client",
          "slug": "client",
          "value": "yes",
          "detailHtml": "Terminal (<code>gc session attach</code>, <code>peek</code>, <code>logs</code>), a local web dashboard of &quot;agents and their sessions, beads, mail, formula runs&quot;, and outside chat or voice front ends over the API; mobile not mentioned",
          "sources": [
            {
              "id": "S9",
              "titleHtml": "Gas City, Inc., Gas City docs: Tutorial 03, Sessions",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/tutorials/03-sessions"
            },
            {
              "id": "S15",
              "titleHtml": "Gas City, Inc., Gas City docs: Dashboard",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/getting-started/dashboard"
            },
            {
              "id": "S11",
              "titleHtml": "Gas City, Inc., Gas City docs: Connect an external client",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/guides/connected-clients"
            }
          ]
        },
        {
          "id": "industry.agent-host",
          "slug": "agent-host",
          "value": "yes",
          "detailHtml": "Its core role: it launches other makers' agent CLIs as sessions it can &quot;start, stop, prompt, and observe&quot;, over tmux or ACP, and adopts them after a restart",
          "sources": [
            {
              "id": "S3",
              "titleHtml": "Gas City, Inc., Gas City docs: How Gas City Works",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/getting-started/how-gas-city-works"
            },
            {
              "id": "S7",
              "titleHtml": "Gas City, Inc., Gas City docs: Configuring an Agent",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/guides/configuring-an-agent"
            },
            {
              "id": "S8",
              "titleHtml": "Gas City, Inc., Gas City docs: Harness Recipes",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/guides/harness-recipes"
            }
          ]
        },
        {
          "id": "industry.channel",
          "slug": "channel",
          "value": "yes",
          "detailHtml": "External messaging: a client &quot;posts each turn in&quot; and &quot;the agent is notified&quot;; verified webhooks can target a <code>conversation</code>; <code>gc session nudge</code> types text &quot;straight into a running agent&quot;",
          "sources": [
            {
              "id": "S11",
              "titleHtml": "Gas City, Inc., Gas City docs: Connect an external client",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/guides/connected-clients"
            },
            {
              "id": "S12",
              "titleHtml": "Gas City, Inc., Gas City docs: Config Reference",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/reference/config"
            },
            {
              "id": "S5",
              "titleHtml": "Gas City, Inc., Gas City docs: Coming from Coding Agents",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/guides/capabilities-for-coding-agent-users"
            }
          ]
        },
        {
          "id": "industry.cross-session-messaging",
          "slug": "cross-session-messaging",
          "value": "yes",
          "detailHtml": "Mail, &quot;a bead (type <code>message</code>)&quot; that &quot;waits in an inbox until read&quot;, and nudge, &quot;a direct poke into a live session&quot;",
          "sources": [
            {
              "id": "S5",
              "titleHtml": "Gas City, Inc., Gas City docs: Coming from Coding Agents",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/guides/capabilities-for-coding-agent-users"
            },
            {
              "id": "S10",
              "titleHtml": "Gas City, Inc., Gas City docs: Tutorial 04, Agent-to-Agent Communication",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/tutorials/04-communication"
            }
          ]
        },
        {
          "id": "spec.acp",
          "slug": "acp",
          "value": "yes",
          "detailHtml": "As client: <code>session = &quot;acp&quot;</code> drives a harness &quot;over the Agent Client Protocol (JSON-RPC over stdio)&quot;, where its provider declares <code>supports_acp = true</code>",
          "sources": [
            {
              "id": "S7",
              "titleHtml": "Gas City, Inc., Gas City docs: Configuring an Agent",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/guides/configuring-an-agent"
            },
            {
              "id": "S12",
              "titleHtml": "Gas City, Inc., Gas City docs: Config Reference",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/reference/config"
            }
          ]
        },
        {
          "id": "spec.ahp",
          "slug": "ahp",
          "value": "unknown",
          "detailHtml": "Not found",
          "sources": []
        },
        {
          "id": "spec.a2a",
          "slug": "a2a",
          "value": "unknown",
          "detailHtml": "Not found",
          "sources": []
        },
        {
          "id": "system.bot",
          "slug": "bot",
          "value": "partial",
          "detailHtml": "Not named a bot: an always-on named session (<code>mode=&quot;always&quot;</code>) has &quot;a stable name … across restarts&quot;, a mail inbox, and orders that run formulas on &quot;cooldown, cron, condition, event, or manual&quot; triggers; the pages read give an agent no memory of its own beyond the shared beads",
          "sources": [
            {
              "id": "S9",
              "titleHtml": "Gas City, Inc., Gas City docs: Tutorial 03, Sessions",
              "read": "2026-11-22",
              "url": "https://docs.gascity.com/tutorials/03-sessions"
