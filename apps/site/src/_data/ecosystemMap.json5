            }
          ]
        },
        {
          "id": "system.bot",
          "slug": "bot",
          "value": "yes",
          "detailHtml": "Bot Mode, on by default in the desktop app: &quot;Each Bot has its own role, model, memory, skills, and avatar&quot;; routines are cron jobs: &quot;Runs land in the Bot's own chat history&quot;",
          "sources": [
            {
              "id": "S7",
