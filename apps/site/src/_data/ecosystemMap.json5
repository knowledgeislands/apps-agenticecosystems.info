              "titleHtml": "Anomaly, OpenCode changelog",
              "read": "2026-11-22",
              "url": "https://opencode.ai/changelog"
            }
          ]
        },
        {
          "id": "industry.agent-team",
          "slug": "agent-team",
          "value": "unknown",
          "detailHtml": "The agents page describes only children reporting to their parent",
          "sources": [
