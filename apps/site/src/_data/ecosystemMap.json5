              "id": "S11",
              "titleHtml": "Paperclip Labs, Paperclip docs: Experimental features",
              "read": "2026-11-22",
              "url": "https://docs.paperclip.ing/experimental/overview/"
            }
          ]
        },
        {
          "id": "industry.client",
          "slug": "client",
          "value": "yes",
          "detailHtml": "Web board and API at <code>localhost:3100</code>, a phone view that installs &quot;as a standalone app&quot;, and the <code>paperclipai</code> CLI; desktop only as a &quot;Community Desktop App (unofficial)&quot;",
          "sources": [
            {
              "id": "S2",
              "titleHtml": "Paperclip Labs, paperclipai/paperclip repository",
              "read": "2026-11-22",
              "url": "https://github.com/paperclipai/paperclip"
            },
            {
              "id": "S4",
              "titleHtml": "Paperclip Labs, changelog v2026.1117.0",
              "read": "2026-11-22",
