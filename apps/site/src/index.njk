---
layout: layouts/base.njk
title: Agentic Ecosystems
permalink: /
---
{#- The one page. Every term, layer and product comes from `_data/ecosystem.json5`; nothing here is content. #}
{%- macro placeholderBadge(entry) -%}
{%- if entry.placeholder %}<span class="badge badge-placeholder">Placeholder</span>{% endif -%}
{%- endmacro %}

<section class="hero" aria-labelledby="page-title">
  <div class="container">
    <h1 id="page-title">{{ site.title }}</h1>
    <p class="lede">A public reference map of agentic systems: the terms, the layers and the products.</p>
    <p>It sets out the words the field uses and what each vendor means by them, the layers from the machine up to the model, and the products that play each part, with what each one can do and its state of play.</p>
    {%- if ecosystem.meta.status == "placeholder" %}
    <aside class="notice" aria-label="Status">
      <p><strong>First cut.</strong> Every entry below is a placeholder, seeded from {{ ecosystem.meta.seededFrom }}. The researched map will replace it from its canonical home in {{ ecosystem.meta.canonicalHome }}.</p>
    </aside>
    {%- endif %}
    <aside class="notice notice-draft" aria-label="Researched so far">
      <p><strong>Researched so far, in draft.</strong> {{ ecosystemMap.products.length }} products are read against {{ ecosystemMap.capabilities.length }} capabilities in the <a href="/matrix/">capability matrix</a>, each with its own page, and the <a href="/crosswalk/">crosswalk</a> sets each term beside what each vendor calls it. They are generated from the Knowledge Islands backpack's knowledge map, as of {{ ecosystemMap.source.reviewed | longDate }}, and are proposals awaiting review.</p>
    </aside>
  </div>
</section>

<section id="terms" class="band" aria-labelledby="terms-title">
  <div class="container">
    <h2 id="terms-title">Terms</h2>
    <p class="section-intro">The vocabulary of agentic systems, with the other words the field uses for the same thing.</p>
    <dl class="term-grid">
      {%- for term in ecosystem.terms %}
      <div class="card" id="term-{{ term.id }}">
        <dt>{{ term.label }} {{ placeholderBadge(term) }}</dt>
        <dd>
          <p>{{ term.definition }}</p>
          {%- if term.alsoCalled and term.alsoCalled.length %}
          <p class="also">Also called: {{ term.alsoCalled | join(", ") }}</p>
          {%- endif %}
        </dd>
      </div>
      {%- endfor %}
    </dl>
  </div>
</section>

<section id="layers" class="band band-inset" aria-labelledby="layers-title">
  <div class="container">
    <h2 id="layers-title">Layers</h2>
    <p class="section-intro">{{ ecosystem.layers.note }}</p>
    <ol class="ladder">
      {%- for rung in ecosystem.layers.rungs %}
      <li class="rung" id="layer-{{ rung.id }}">
        <span class="rung-label">{{ rung.label }}</span>
        <span class="rung-summary">{{ rung.summary }}</span>
        {{ placeholderBadge(rung) }}
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section id="products" class="band" aria-labelledby="products-title">
  <div class="container">
    <h2 id="products-title">Products</h2>
    <p class="section-intro">The products in the ecosystem and the product roles each one plays: {% for role in ecosystem.productRoles %}{{ role.label | lower }}{% if not loop.last %}, {% endif %}{% endfor %}. One product may play several.</p>
    {%- for group in ecosystem.productGroups %}
    <h3 id="group-{{ group.id }}">{{ group.label }}</h3>
    <ul class="product-grid" aria-labelledby="group-{{ group.id }}">
      {%- for product in ecosystem.products | whereEq("group", group.id) %}
      <li class="card" id="product-{{ product.id }}">
        <p class="product-name">{{ product.name }} {{ placeholderBadge(product) }}</p>
        {%- if product.maker %}
        <p class="product-maker">{{ product.maker }}</p>
        {%- endif %}
        {%- if product.roles.length %}
        <ul class="roles" aria-label="Product roles">
          {%- for role in product.roles %}
          <li class="badge">{{ ecosystem.productRoles | labelFor(role) }}</li>
          {%- endfor %}
        </ul>
        {%- else %}
        <p class="roles-pending">Product roles not yet mapped</p>
        {%- endif %}
        {%- if product.note %}
        <p class="product-note">{{ product.note }}</p>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
    {%- endfor %}
  </div>
</section>
