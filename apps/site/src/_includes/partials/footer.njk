{# The footer names the parent site. Its wording and link come from `site.parent`. #}
<footer class="site-footer">
  <div class="container footer-row">
    <p><a class="footer-parent" href="{{ site.parent.href }}">{{ site.parent.label }}</a></p>
    <p class="footer-meta">Map revised {{ ecosystem.meta.revised }}</p>
  </div>
</footer>
